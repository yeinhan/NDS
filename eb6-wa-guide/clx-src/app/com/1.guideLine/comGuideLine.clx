        <cl:sectionitem std:sid="s-item-37cabe36" title="항목 13. (문자 단축키) 문자 단축키는 오동작으로 인한 오류를 방지하여야 한다.">
          <cl:group std:sid="group-4782550d" id="grp28">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-eb598dff" id="grp8">
              <std:metadata>
                <std:property key="locked" value="true"/>
              </std:metadata>
              <cl:verticaldata std:sid="v-data-799a19ff" width="1178px" height="42px" autosize="height"/>
              <cl:group std:sid="group-e72593e3" id="grp9">
                <cl:verticaldata std:sid="v-data-5338ca71" width="1158px" height="43px" autosize="height"/>
                <cl:output std:sid="output-bcc617cf" value="준수 기준 : 단일 문자 단축키를 사용하지 않도록 설정하거나 재설정하는 방법을 제공하거나 초점을 받은 상태에서만 실행되도록 구현한 경우, 준수한 것으로 인정">
                  <cl:verticaldata std:sid="v-data-5a7fbfdf" width="1180px" height="18px" autosize="height"/>
                </cl:output>
