            </std:metadata>
            <cl:group std:sid="group-74a9e8f3" id="grp54">
              <cl:verticaldata std:sid="v-data-e010c28d" width="1178px" height="247px" autosize="height"/>
              <cl:output std:sid="output-abc06719" value="준수 기준 : 웹페이지에서 제공하는 모든 이웃한 컨트롤들은 개별적으로 선택하고 사용할 수 있도록 대각선 길이가 6.0mm 이상의 크기와 컨트롤의 안쪽 여백이 1픽셀 이상을 갖도록 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-f8bb0ce4" width="1180px" height="18px" autosize="height"/>
              </cl:output>
