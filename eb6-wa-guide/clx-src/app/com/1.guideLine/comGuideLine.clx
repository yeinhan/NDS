        <cl:verticaldata std:sid="v-data-53264fec" width="1180px" height="252px" autosize="height"/>
        <cl:sectionitem std:sid="s-item-fedee2ea" selected="true" title="항목 32. (마크업 오류 방지) 마크업 언어의 요소는 열고 닫음, 중첩 관계 및 속성 선언에 오류가 없어야 한다.">
          <cl:group std:sid="group-55fe23c1" id="grp19">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-ba2f242a" id="grp20">
              <cl:verticaldata std:sid="v-data-e4f784f8" width="1178px" height="48px" autosize="height"/>
              <cl:output std:sid="output-ec3082ed" value="준수 기준 : 마크업 언어 요소의 열고 닫음, 중첩 관계 및 속성 선언에 대한 문법 오류 없이 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-6b48f6df" width="1148px" height="30px" autosize="none"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-9562f5b6" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
