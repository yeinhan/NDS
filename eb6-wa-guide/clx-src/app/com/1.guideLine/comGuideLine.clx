        <cl:property name="title" value="원칙 4. 견고성 (Robust)" type="string"/>
      </cl:udc>
      <cl:accordion std:sid="accordion-c1a67fe7" id="acdGuideLine4" class="guideLine" multiple="true">
        <std:metadata>
