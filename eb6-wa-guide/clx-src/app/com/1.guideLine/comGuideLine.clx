        <cl:sectionitem std:sid="s-item-e20ecbf1" title="항목 3. (표의 구성) 표는 이해하기 쉽게 구성해야 한다.">
          <cl:group std:sid="group-520bb175" id="grp65">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-792153b3" id="grp66">
              <cl:verticaldata std:sid="v-data-31b4db7b" width="1178px" height="37px" autosize="height"/>
              <cl:output std:sid="output-913bc61c" value="준수 기준 : 표를 이해할 수 있도록 정보를 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-4c641e26" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-a25eb93a" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-14331f12"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-71ff6fd3" title="항목 4. (콘텐츠의 선형 구조) 콘텐츠는 논리적인 순서로 제공해야 한다.">
          <cl:group std:sid="group-3b6f89a7" id="grp68">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-b0818e30" id="grp17">
              <cl:verticaldata std:sid="v-data-9098308d" width="1178px" height="41px" autosize="height"/>
              <cl:output std:sid="output-c5dfd902" value="준수 기준 : 콘텐츠의 순서가 논리적으로 선형화되어 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-38a9a832" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-4251b4b0" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-b6fb8bef"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-fec8f56d" selected="true" title="항목 5. (명확한 지시사항 제공) 지시사항은 모양, 크기, 위치, 방향, 색, 소리 등에 관계없이 인식될 수 있어야 한다.">
          <cl:group std:sid="group-7699aaac" id="grp39">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-099ad5b7" id="grp14">
              <cl:verticaldata std:sid="v-data-0f20041e" width="1178px" height="37px" autosize="height"/>
              <cl:output std:sid="output-0f6a17c1" value="준수 기준 : 지시사항 정보를 특정 감각에 의존하지 않고 다양한 감각을 통해 용도나 목적을 이해할 수 있도록 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-87b3aa9d" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-11965fcb" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-76346591"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-ea36cfa9" selected="true" title="항목 6. (색에 무관한 콘텐츠 인식) 콘텐츠는 색에 관계없이 인식될 수 있어야 한다.">
          <cl:group std:sid="group-c3d2ca82" id="grp38">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-87202042" id="grp13">
              <cl:verticaldata std:sid="v-data-2ada94f5" width="1158px" height="43px" autosize="height"/>
              <cl:output std:sid="output-cd55b5c7" value="준수 기준 : 색을 배제하더라도 인식할 수 있는 콘텐츠를 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-3b6a4b9a" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-764bcb26" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-1dac5129"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-9895dfd5" selected="true" title="항목 7. (자동 재생 금지) 자동으로 소리가 재생되지 않아야 한다.">
          <cl:group std:sid="group-cf35fd8c" id="grp41">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-1538751d" id="grp44">
              <std:metadata>
                <std:property key="locked" value="true"/>
              </std:metadata>
              <cl:verticaldata std:sid="v-data-3803346a" width="1178px" height="42px" autosize="height"/>
              <cl:group std:sid="group-cd49aeee" id="grp45">
                <cl:verticaldata std:sid="v-data-f6aa51e7" width="1158px" height="43px" autosize="height"/>
                <cl:output std:sid="output-33f32fb6" value="준수 기준 : 소리를 사용하지 않았거나 3초 이내 또는 바로 정지할 수 있는 소리 콘텐츠를 사용한 경우, 준수한 것으로 인정">
                  <cl:verticaldata std:sid="v-data-2d44f65b" width="1180px" height="18px" autosize="height"/>
                </cl:output>
                <cl:verticallayout std:sid="v-layout-6f79e497" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
              </cl:group>
              <cl:verticallayout std:sid="v-layout-17046818"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-2bcfd03c"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-ae0aa29e" selected="true" title="항목 8. (텍스트 콘텐츠의 명도 대비) 텍스트 콘텐츠와 배경 간의 명도 대비는 4.5대 1 이상이어야 한다.">
          <std:metadata>
            <std:property key="is-active-item" value="true"/>
          </std:metadata>
          <cl:group std:sid="group-19938923" id="grp40">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-fb0ab7d1" id="grp15">
              <std:metadata>
                <std:property key="locked" value="true"/>
              </std:metadata>
              <cl:verticaldata std:sid="v-data-a903a170" width="1178px" height="42px" autosize="height"/>
              <cl:group std:sid="group-0250b9b6" id="grp16">
                <cl:verticaldata std:sid="v-data-81b09310" width="1158px" height="43px" autosize="height"/>
                <cl:output std:sid="output-87327b4f" value="준수 기준 : 텍스트 콘텐츠의 명도 대비가 4.5:1 이상, 18pt 또는 굵은 14pt 이상에서 3:1 이상, 화면 확대가 가능하도록 구현한 콘텐츠의 명도 대비가 3:1 이상일 경우, 준수한 것으로 인정">
                  <cl:verticaldata std:sid="v-data-b141b407" width="1180px" height="18px" autosize="height"/>
                </cl:output>
                <cl:verticallayout std:sid="v-layout-d0838a26" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
              </cl:group>
              <cl:verticallayout std:sid="v-layout-547e5bf7"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-bdc97a92"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-77afa894" selected="true" title="항목 9. (콘텐츠 간의 구분) 이웃한 콘텐츠는 구별될 수 있어야 한다.">
          <cl:group std:sid="group-233c7680" id="grp12">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-8f531d2d" id="grp36">
              <cl:verticaldata std:sid="v-data-7c99c782" width="1178px" height="48px" autosize="height"/>
              <cl:output std:sid="output-c822a199" value="준수 기준 : 이웃한 콘텐츠는 시각적으로 구별되도록 충분한 간격을 두어 구현한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-09201564" width="1148px" height="30px" autosize="none"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-83054e6b" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-e3a3c2b4"/>
          </cl:group>
        </cl:sectionitem>
      </cl:accordion>
      <cl:verticallayout std:sid="v-layout-44042cc3" scrollable="false" spacing="40" leftmargin="50" rightmargin="50" topmargin="50" bottommargin="50"/>
    </cl:group>
