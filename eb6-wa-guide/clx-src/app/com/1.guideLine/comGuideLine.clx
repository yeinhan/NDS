        <cl:sectionitem std:sid="s-item-571bbadc" title="항목 20. (고정된 참조 위치 정보) 전자출판문서 형식의 웹페이지는 각 페이지로 이동할 수 있는 기능이 있어야 하고, 서식이나 플랫폼에 상관없이 참조 위치 정보를 일관되게 제공·유지해야 한다.">
          <cl:group std:sid="group-baf4ca65" id="grp29">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-e24a680c" id="grp18">
              <cl:verticaldata std:sid="v-data-e87d7868" width="1178px" height="43px" autosize="height"/>
              <cl:output std:sid="output-5fc0e4a8" value="준수 기준 : 웹페이지로 제공되는 전자출판문서에 대해 콘텐츠의 확대/축소 등으로 서식이 변경되거나 임의의 페이지로 이동하더라도 각 페이지로 이동할 수 있는 기능과 현재 위치 정보가 일관되게 제공·유지되는 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-6df95208" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-961f9244" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-42547525"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-e6b2cced" title="항목 21. (단일 포인터 입력 지원) 다중 포인터 또는 경로기반 동작을 통한 입력은 단일 포인터 입력으로도 조작할 수 있어야 한다.">
          <cl:group std:sid="group-fbd8a2d3" id="grp30">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-fe64e4f4" id="grp26">
              <cl:verticaldata std:sid="v-data-d8fe62b4" width="1178px" height="43px" autosize="height"/>
              <cl:output std:sid="output-7d3cfadf" value="준수 기준 : 다중 포인터 또는 경로 기반 동작 수행을 제공할 때 동일 결과를 얻기 위한 단일 포인터 입력 방식의 컨트롤을 병행하여 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-5f1e6b59" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-ab62d623" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-6150bdef"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-827476f9" title="항목 22. (포인터 입력 취소) 단일 포인터 입력으로 실행되는 기능은 취소할 수 있어야 한다.">
          <cl:group std:sid="group-27eed5c6" id="grp35">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-a8104323" id="grp67">
              <cl:verticaldata std:sid="v-data-ce39e4a3" width="1178px" height="43px" autosize="height"/>
              <cl:output std:sid="output-250e12ed" value="준수 기준 : 단일 포인터 입력으로 실행되는 기능은 해당 입력이 실수로 실행되는 것을 방지하기 위해 취소할 수 있는 기능을 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-4509a67a" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-eab04ad7" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-287208be"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-647f8eba" title="항목 23. (레이블과 네임) 텍스트 또는 텍스트 이미지가 포함된 레이블이 있는 사용자 인터페이스 구성요소는 네임에 시각적으로 표시되는 해당 텍스트를 포함해야 한다.">
          <cl:group std:sid="group-889947bd" id="grp56">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-580da58b" id="grp69">
              <cl:verticaldata std:sid="v-data-df4b44a0" width="1178px" height="43px" autosize="height"/>
              <cl:output std:sid="output-789a0f15" value="준수 기준 : 시각적으로 보이는 레이블에 대한 네임(name)을 적절하게 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-8e0ed1b8" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-4007f4b0" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-ecd54a52"/>
          </cl:group>
        </cl:sectionitem>
        <cl:sectionitem std:sid="s-item-6d13ad6e" title="항목 24. (동작 기반 작동) 동작 기반으로 작동하는 기능은 사용자 인터페이스 구성요소로 조작할 수 있고, 동작 기반 기능을 비활성화할 수 있어야 한다.">
          <cl:group std:sid="group-02a15eb4" id="grp64">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
            <cl:group std:sid="group-2b5c2264" id="grp70">
              <cl:verticaldata std:sid="v-data-4944dd75" width="1178px" height="43px" autosize="height"/>
              <cl:output std:sid="output-ae27cbb9" value="준수 기준 : 동작 기반으로 작동하는 기능은 사용자 인터페이스 구성요소로 조작할 수 있고, 동작 기반 작동에 대한 비활성화 기능을 제공한 경우, 준수한 것으로 인정">
                <cl:verticaldata std:sid="v-data-97066686" width="1180px" height="18px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-c4f91205" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-5ef96e2d"/>
          </cl:group>
        </cl:sectionitem>
      </cl:accordion>
      <cl:verticallayout std:sid="v-layout-1371f41e" scrollable="false" spacing="40" leftmargin="50" rightmargin="50" topmargin="50" bottommargin="50"/>
    </cl:group>
