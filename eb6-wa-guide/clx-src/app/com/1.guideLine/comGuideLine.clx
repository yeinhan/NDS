          <cl:verticaldata std:sid="v-data-c42713a6" width="1180px" height="20px" syncminheight="true" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-992017d7" value="" displayexp="&quot;※ 지침 목록에 제공된 그리드의 &quot;+sstr(&quot;필수 컬럼&quot;, [&quot;fw-bold&quot;])&#xD;&#xA;+ &quot;은 접근성은 준수하기 위해 컨트롤에 적용되어야 하는 속성 및 조치의 필수 여부를 의미합니다.\n&quot;&#xD;&#xA;+ &quot;아래 체크박스를 통해 전체 항목 중 필수 항목만 조회할 수 있고\n&quot;&#xD;&#xA;+ &quot;그리드 헤더의  filter 버튼을 통해 개별 그리드의 필수 항목만 조회할 수 있습니다. &quot;">
          <cl:verticaldata std:sid="v-data-07d60e82" width="100px" height="38px" autosize="height"/>
        </cl:output>
        <cl:checkbox std:sid="c-box-4aa9c4fa" id="cbx2" falsevalue="false" text="필수 항목만 보기">
