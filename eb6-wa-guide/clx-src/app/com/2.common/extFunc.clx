  <body std:sid="body-2d34bd2e">
    <cl:listener std:sid="listener-687c73c7" name="init" handler="onBodyInit"/>
    <cl:udc std:sid="ud-control-39996f37" id="breadcrumbs1" type="udc.pb.Breadcrumbs">
      <cl:verticaldata std:sid="v-data-37da5297" width="1644px" height="174px" autosize="height"/>
      <cl:property name="title" value="웹 접근성 관련 공통 모듈" type="string"/>
    </cl:udc>
    <cl:group std:sid="group-6c4646a5" id="grp1" class="bg-primary-dim">
      <cl:verticaldata std:sid="v-data-bc4a348e" width="400px" height="105px" autosize="height"/>
      <cl:output std:sid="output-a5bbbbb2" displayexp="&quot;본 화면에서는 웹 접근성 준수하기 위한 확장기능에 대해서 확인할 수 있습니다.\n&quot;&#xD;&#xA;+&quot;확장기능은 &quot; + sstr(&quot;module/wa/accessibility.module.js(이하 공통모듈)&quot;, [&quot;text-danger&quot;, &quot;fw-bold&quot;])+ &quot; 에서 제공하고  있으며, 각 &quot; + sstr(&quot;프로젝트 별 커스터마이징을 필수적으로 선행&quot;, [&quot;text-underline&quot;]) + &quot;하시기 바랍니다.\n&quot;&#xD;&#xA;+&quot;공통모듈에서 수정가능한 변수는 &quot; + sstr(&quot;module/wa/accessibilityProperties.module.js&quot;, [&quot;text-primary&quot;, &quot;fw-bold&quot;]) +&quot; 에 정의되어있으니, 해당 파일을 반드시 확인하시기 바랍니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+&quot;모듈에서 최초 제공해드린 기능은 아래 샘플을 통해 확인할 수 있습니다.\n&quot;&#xD;&#xA;+&quot;샘플을 확인하실 때에는 스크린리더 프로그램을 실행하고 확인하는 것을 권장합니다.&quot;">
        <cl:verticaldata std:sid="v-data-89cd7f2b" width="100px" height="85px" autosize="height"/>
      </cl:output>
