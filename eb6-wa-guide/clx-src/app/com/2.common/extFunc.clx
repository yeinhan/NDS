    </cl:group>
    <cl:group std:sid="group-aa74d85c" id="grp18" class="border rounded">
      <cl:verticaldata std:sid="v-data-3a319286" width="1220px" height="330px" autosize="height"/>
      <cl:udc std:sid="ud-control-d00d919b" id="sectiontitle8" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-af407986" width="1644px" height="29px" autosize="height"/>
        <cl:property name="title" value="버튼타입 아웃풋" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-76236b59" value="아웃풋의 tabIndex=0 이 적용되어 있는 경우, 아웃풋은 버튼과 동일한 형태로 기능을 제공합니다.&#xD;&#xA;role=button 이 적용되어 스크린 리더는 버튼으로 인식하며, Enter 키를 눌러 click 이벤트를 발생시킵니다.">
        <cl:verticaldata std:sid="v-data-a5d70e31" width="1198px" height="59px" autosize="height"/>
      </cl:output>
      <cl:udc std:sid="ud-control-5badc780" id="udcexamace7" type="udc.exam.udcExamAce">
        <cl:verticaldata std:sid="v-data-9dbb1ad8" width="1178px" height="180px" autosize="height"/>
        <cl:property name="title" value="관련 속성" type="string"/>
        <cl:property name="value" value="/**&#xD;&#xA; * [아웃풋] 버튼 역할 아웃풋(tabIndex>=0)&#xD;&#xA; * ● 적용 기술 : 포커스 가능한 아웃풋은 버튼으로 인식되도록 role=button 적용 및 Enter 시 클릭 이벤트 전파&#xD;&#xA; * (default : false)&#xD;&#xA; */&#xD;&#xA;AccessibilityProperties.prototype.SET_FOCUSABLE_OUPTUT = false;" type="string"/>
      </cl:udc>
      <cl:verticallayout std:sid="v-layout-319542cb" spacing="10" leftmargin="20" rightmargin="20" topmargin="20" bottommargin="20"/>
    </cl:group>
    <cl:group std:sid="group-a4052ac5" id="grp5" class="border rounded">
      <cl:verticaldata std:sid="v-data-c86ad6c0" width="1220px" height="500px" autosize="height"/>
      <cl:udc std:sid="ud-control-94a3a78c" id="sectiontitle7" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-cca84444" width="1644px" height="29px" autosize="height"/>
        <cl:property name="title" value="HTML 파일 생성" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-39ae16ce" displayexp="&quot;웹 접근성 자가진단 또는 웹 표준 검사를 진행 할 경우, URL 혹은 HTML 파일이 필요합니다.\n&quot;&#xD;&#xA;+&quot;SPA(Single Page Application) 으로 구현된 화면의 경우 URL 로 확인할 수 없으므로 &quot;+sstr(&quot;HTML 파일을 통해 검사를 진행&quot;, [&quot;text-underline&quot;])+&quot;합니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+&quot;다음 함수(makeHtmlFile) 를 호출하여 현재 화면을 HTML 파일로 다운로드 받을 수 있습니다.\n&quot;&#xD;&#xA;+&quot;HTML 파일은 브라우저에 그려지는 전체화면을 대상으로 합니다.\n&quot;&#xD;&#xA;+&quot;검사를 진행하고자 하는 모든 화면을 HTML 파일로 생성하고, 해당 파일을 검사를 진행하시기 바랍니다.&quot;">
        <cl:verticaldata std:sid="v-data-a1f944c7" width="1198px" height="59px" autosize="height"/>
      </cl:output>
      <cl:udc std:sid="ud-control-cf161f89" id="udcexamace1" type="udc.exam.udcExamAce">
        <cl:verticaldata std:sid="v-data-e48fd937" width="300px" height="300px" autosize="height"/>
        <cl:property name="value" value="function onBtnClick(e){&#xD;&#xA;&#x9;var btn = e.control;&#xD;&#xA;&#xD;&#xA;&#x9;makeHtmlFile(&quot;파일명&quot;); // 파일명.html 로 다운로드 실행&#xD;&#xA;}" type="string"/>
      </cl:udc>
      <cl:group std:sid="group-68c95c67" id="grp16" class="cl-form-group">
        <cl:verticaldata std:sid="v-data-6244725d" width="1178px" height="40px" autosize="height"/>
        <cl:output std:sid="output-18deb70c" value="HTML 생성">
          <cl:formdata std:sid="f-data-f3d6564d" row="0" col="0"/>
        </cl:output>
        <cl:group std:sid="group-a15a369a" id="grp17">
          <cl:formdata std:sid="f-data-3977c6c1" row="0" col="1" rowspan="1" colspan="1"/>
          <cl:inputbox std:sid="i-box-285c71e5" id="ipbFileName" value="EXB_HTML_FILE" placeholder="파일명을 입력하세요">
            <cl:flowlayoutdata std:sid="f-data-00a3f85c" width="200px" height="30px"/>
          </cl:inputbox>
          <cl:button std:sid="button-15dcda5b" id="btn1" class="btn-primary" value="HTML생성">
            <cl:listener std:sid="listener-cca39274" name="click" handler="onBtn1Click"/>
            <cl:flowlayoutdata std:sid="f-data-0accc35b" width="100px" height="28px"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-465bc0a1" scrollable="false"/>
        </cl:group>
        <cl:formlayout std:sid="f-layout-cb22e8cd" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="140" unit="PIXEL" shadetype="BY_CLASS"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-54515f3e" spacing="10" leftmargin="20" rightmargin="20" topmargin="20" bottommargin="20"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-4d8579cf" spacing="30" leftmargin="30" rightmargin="30" topmargin="0" bottommargin="0"/>
