    </cl:group>
    <cl:group std:sid="group-00f5fb58" id="grp8" class="border rounded">
      <cl:verticaldata std:sid="v-data-11703ed3" width="1240px" height="557px" autosize="height"/>
      <cl:udc std:sid="ud-control-8291c852" id="sectiontitle3" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-deb25c08" width="1644px" height="29px" autosize="height"/>
        <cl:property name="title" value="그리드 헤더 정보 제공" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-64bcb12a" displayexp="&quot;그리드의 각 셀을 탐색할 때, 헤더에 대한 정보를 알 수 있어야 합니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+&quot;공통모듈에서는 각 셀의 fieldLabel 속성에 설정함으로써 헤더 정보를 제공합니다.\n&quot;&#xD;&#xA;+&quot;fieldLabel 은 셀에 배치된 컨트롤에 우선적으로 적용되며, 컨트롤이 배치되어 있지 않을 경우 셀에 적용됩니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+sstr(&quot;만약 공통모듈에서 설정한 값을 적용하고 싶지 않으시면 해당 &quot;, [&quot;text-underline&quot;])&#xD;&#xA;+sstr(&quot;셀 또는 컨트롤의 fieldLabel 에 직접 값을 작성&quot;, [&quot;text-underline&quot;, &quot;text-danger&quot;]) &#xD;&#xA;+sstr(&quot;하면 됩니다.&quot;, [&quot;text-underline&quot;])">
        <cl:verticaldata std:sid="v-data-73b537d5" width="1198px" height="59px" autosize="height"/>
      </cl:output>
      <cl:udc std:sid="ud-control-2cecaa73" id="udcexamace4" type="udc.exam.udcExamAce">
        <cl:verticaldata std:sid="v-data-2ab40c5c" width="1178px" height="180px" autosize="height"/>
        <cl:property name="title" value="관련 속성" type="string"/>
        <cl:property name="value" value="/**&#xD;&#xA; * [그리드]  마지막 행/열 정보 추가 여부&#xD;&#xA; * (default : true)&#xD;&#xA; */&#xD;&#xA;AccessibilityProperties.prototype.SET_GRID_LAST_CELL_INFO = true;&#xD;&#xA;&#xD;&#xA;/**&#xD;&#xA; * [그리드] 행 상태 정보 제공 여부 (신규행/삭제행/수정행)&#xD;&#xA; * (default : false)&#xD;&#xA; */&#xD;&#xA;AccessibilityProperties.prototype.SET_GRID_ROW_STATE_INFO = false;" type="string"/>
      </cl:udc>
