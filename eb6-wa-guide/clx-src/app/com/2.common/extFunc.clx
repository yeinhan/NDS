    <cl:group std:sid="group-ee89d323" id="grp6" class="border rounded">
      <cl:verticaldata std:sid="v-data-4361f8df" width="1240px" height="540px" autosize="height"/>
      <cl:udc std:sid="ud-control-37ec733a" id="sectiontitle2" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-a8a49525" width="1644px" height="29px" autosize="height"/>
        <cl:property name="title" value="확장형 버튼" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-603d2c84" value="버튼 클릭 시 하위 영역을 접고 펼치는 동작을 할 경우, 해당 동작에 대한 음성을 제공합니다.&#xD;&#xA;&#xD;&#xA;공통모듈에서는 확장형 스타일 클래스 가 적용되어 있는 버튼에 대해 aria-expanded 속성을 지원합니다.&#xD;&#xA;해당 버튼에 확장 클래스 가 추가적으로 설정 될 경우 스크린리더는 [확장됨] 이라고 읽습니다.">
        <cl:verticaldata std:sid="v-data-3e7e794c" width="1198px" height="59px" autosize="height"/>
      </cl:output>
      <cl:udc std:sid="ud-control-2699e9c8" id="udcexamace3" type="udc.exam.udcExamAce">
        <cl:verticaldata std:sid="v-data-13942623" width="1178px" height="180px" autosize="height"/>
        <cl:property name="value" value="/**&#xD;&#xA; * [버튼] 하위 영역을 확장/축소 가능한 아코디언 버튼 스타일 클래스&#xD;&#xA; * ● 적용 기술 : aria-expanded=false 적용&#xD;&#xA; */&#xD;&#xA;AccessibilityProperties.prototype.BTN_TOGGLE_CLS = [&quot;btn-expanded&quot;];&#xD;&#xA;&#xD;&#xA;/**&#xD;&#xA; * [버튼] AccessibilityProperties.BTN_TOGGLE_CLS 가 적용된 버튼&#xD;&#xA; * ● 적용 기술 : aria-expanded=true 적용&#xD;&#xA; */&#xD;&#xA;AccessibilityProperties.prototype.BTN_TOGGLE_EXPAND_CLS = [&quot;expand&quot;];" type="string"/>
        <cl:property name="title" value="관련 속성" type="string"/>
      </cl:udc>
      <cl:group std:sid="group-82baf87d" id="grpToggle" class="border">
        <cl:verticaldata std:sid="v-data-190436af" width="400px" height="200px" autosize="height"/>
