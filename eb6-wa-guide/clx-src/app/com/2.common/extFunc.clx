            </cl:combobox>
          </cl:gridcell>
          <cl:gridcell std:sid="gd-cell-c7a2e65b" rowindex="0" colindex="8" columnname="SALARY">
            <cl:numbereditor std:sid="n-editor-e4ca644b" id="nbe6" fieldLabel="연봉" value="0" format="s#,###">
              <cl:celldata std:sid="c-data-27f912ca"/>
