              </cl:maskeditor>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-dfddf0c6" rowindex="0" colindex="6" columnname="HIRE_DATE">
              <cl:dateinput std:sid="d-input-95ec9ba6" id="dti4" fieldLabel="고용일" mask="YYYY-MM-DD">
                <cl:celldata std:sid="c-data-bd5a0905" topSpacing="4" bottomSpacing="4" leftSpacing="4" rightSpacing="4"/>
              </cl:dateinput>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-e6b73075" rowindex="0" colindex="7" columnname="DEPARTMENT_ID">
              <cl:combobox std:sid="c-box-8b867b8f" id="cmb4" class="required" fieldLabel="부서ID">
                <cl:celldata std:sid="c-data-6e28fe76" topSpacing="4" bottomSpacing="4" leftSpacing="4" rightSpacing="4"/>
                <cl:itemset datasetid="dsDept" label="DEPT_NAME" value="DEPT_NO"/>
              </cl:combobox>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-d0145ae2" rowindex="0" colindex="8" columnname="SALARY">
              <cl:numbereditor std:sid="n-editor-a344658c" id="nbe4" fieldLabel="연봉" value="0" format="s#,###">
                <cl:celldata std:sid="c-data-88311725" topSpacing="4" bottomSpacing="4" leftSpacing="4" rightSpacing="4"/>
              </cl:numbereditor>
            </cl:gridcell>
