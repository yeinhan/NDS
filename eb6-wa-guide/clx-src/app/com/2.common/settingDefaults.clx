  <body std:sid="body-cc7794bc">
    <cl:listener std:sid="listener-d233854c" name="init" handler="onBodyInit"/>
    <cl:group std:sid="group-6c4646a5" id="grp1" class="bg-primary-dim">
      <cl:formdata std:sid="f-data-4083f02a" row="1" col="0" rowspan="1" colspan="1"/>
      <cl:output std:sid="output-a5bbbbb2" displayexp="&quot;본 화면에서는 웹 접근성 준수 및 사용자 편의성을 확장하기 위해 &quot; &#xD;&#xA;+ sstr(&quot;각 컨트롤 별 정의된 기본 표준속성&quot;, [&quot;text-primary&quot;, &quot;text-underline&quot;]) &#xD;&#xA;+ &quot;에 대해 설명합니다.\n&quot;&#xD;&#xA;&#xD;&#xA;+ &quot;기본 속성은 &quot; &#xD;&#xA;+  sstr(&quot;defaults.js&quot;, [&quot;text-primary&quot;, &quot;text-underline&quot;]) &#xD;&#xA;+ &quot; 파일을 통해 설정하며, 설정된 값은 속성의 기본 값으로 설정됩니다.\n&quot;&#xD;&#xA;+ &quot;아래 &quot; + sstr(&quot;필수여부가 Y&quot;, [&quot;text-danger&quot;]) +&quot;로 되어 있는 속성은 웹 접근성 준수를 위해 반드시 설정할 것을 권장드립니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;+ &quot;각 화면에서는 표준속성값을 사용하지 않고 수정할 수 있지만,\n&quot;&#xD;&#xA;+ &quot;표준을 위해 설정된 값이기 때문에 잦은 변경을 지양해야 하며, &quot; + sstr(&quot;반드시 필요한 경우에만 수정할 것을 권고드립니다.&quot;, [&quot;text-underline&quot;])">
        <cl:verticaldata std:sid="v-data-89cd7f2b" width="100px" height="140px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-e2a63d96" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
    </cl:group>
    <cl:group std:sid="group-bfe31598" id="grp2">
      <cl:formdata std:sid="f-data-52f0d47b" row="2" col="0" rowspan="1" colspan="1"/>
      <cl:grid std:sid="grid-72219c84" id="grd1" datasetid="dsList" autofit="2, 3" enabledcellautowidth="true" autorowheight="all" suppressedcelltype="merged" resizablecolumns="all" columnMovable="true">
        <cl:formdata std:sid="f-data-6b15b81e" row="0" col="1"/>
