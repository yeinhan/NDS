            <cl:output std:sid="output-74625d4d" class="text-center">
              <cl:celldata std:sid="c-data-868f759d"/>
            </cl:output>
          </cl:gridcell>
          <cl:gridcell std:sid="gd-cell-c27464a6" rowindex="0" colindex="1" columnname="PROP_NM">
            <cl:output std:sid="output-7cc0a71d">
              <cl:expbind property="class" category="CLASS" expression="REQ_YN == &quot;Y&quot; ? &quot;text-indigo fw-medium bg-primary-dim&quot; : &quot;&quot;"/>
              <cl:celldata std:sid="c-data-622c247b"/>
            </cl:output>
          </cl:gridcell>
          <cl:gridcell std:sid="gd-cell-87f356e3" rowindex="0" colindex="2" columnname="PROP_VAL">
            <cl:output std:sid="output-a80ba4a1">
              <cl:expbind property="class" category="CLASS" expression="REQ_YN == &quot;Y&quot; ? &quot;text-indigo fw-medium bg-primary-dim&quot; : &quot;&quot;"/>
