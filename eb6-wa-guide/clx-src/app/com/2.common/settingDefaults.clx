            <cl:datavalue columnname="PROP_NM">viewingMode</cl:datavalue>
            <cl:datavalue columnname="PROP_VAL">button</cl:datavalue>
            <cl:datavalue columnname="PROP_CONT">뷰잉모드에서 버튼이 표현됩니다. (서치 인풋, 데이트 인풋, 콤보박스)</cl:datavalue>
