            <cl:datavalue columnname="PROP_CONT"><![CDATA[clear버튼을 표시하지 않습니다.]]></cl:datavalue>
            <cl:datavalue columnname="MIN_VERSION">-</cl:datavalue>
            <cl:datavalue columnname="REQ_YN">N</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="CTRL_NM">searchinput</cl:datavalue>
            <cl:datavalue columnname="PROP_NM">hideSearchButton</cl:datavalue>
            <cl:datavalue columnname="PROP_VAL">false</cl:datavalue>
            <cl:datavalue columnname="PROP_CONT"><![CDATA[search버튼의 표시합니다.]]></cl:datavalue>
            <cl:datavalue columnname="MIN_VERSION">-</cl:datavalue>
            <cl:datavalue columnname="REQ_YN">N</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="CTRL_NM">searchinput</cl:datavalue>
            <cl:datavalue columnname="PROP_NM">searchLabelExp</cl:datavalue>
            <cl:datavalue columnname="PROP_VAL">fieldLabel +' '+i18n('--cpr-search')</cl:datavalue>
            <cl:datavalue columnname="PROP_CONT">서치 버튼의 aria-label 속성을 설정합니다. </cl:datavalue>
            <cl:datavalue columnname="MIN_VERSION">1.0.4727</cl:datavalue>
            <cl:datavalue columnname="REQ_YN">N</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="CTRL_NM">searchinput</cl:datavalue>
            <cl:datavalue columnname="PROP_NM">clearLabelExp</cl:datavalue>
            <cl:datavalue columnname="PROP_VAL">fieldLabel +' '+i18n('--cpr-clear')</cl:datavalue>
            <cl:datavalue columnname="PROP_CONT">클리어 버튼의 aria-label 속성을 설정합니다. </cl:datavalue>
            <cl:datavalue columnname="MIN_VERSION">1.0.4727</cl:datavalue>
            <cl:datavalue columnname="REQ_YN">N</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="CTRL_NM">tabfolder</cl:datavalue>
            <cl:datavalue columnname="PROP_NM">tabsWithAutoSelection</cl:datavalue>
            <cl:datavalue columnname="PROP_VAL"><![CDATA[false]]></cl:datavalue>
            <cl:datavalue columnname="PROP_CONT"><![CDATA[탭 아이템 이동 시 Enter 키로 탭 아이템을 직접 선택합니다.]]></cl:datavalue>
            <cl:datavalue columnname="MIN_VERSION">1.0.4523</cl:datavalue>
            <cl:datavalue columnname="REQ_YN">N</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="defaults.js 설정"/>
