      </cl:grid>
      <cl:udc std:sid="ud-control-eddac5f3" id="udcexamace1" type="udc.exam.udcExamAce">
        <cl:formdata std:sid="f-data-87441d48" row="0" col="0"/>
        <cl:property name="value" value="/**&#xD;&#xA; * Control별 기본 값 및 공통 상수 정의&#xD;&#xA; */&#xD;&#xA;var CPR_DEFAULTS = {&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;controls: {&#xD;&#xA;&#x9;&#x9;/* 각 개별 Control 관련 기본 설정. 속성, Style,... */&#xD;&#xA;&#x9;&#x9;controls: {&#xD;&#xA;&#x9;&#x9;&#x9;dialog: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;autoFocusedTarget: &quot;auto&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;restoreFocus: true&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;dateinput: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;buttonFocusable: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;showClearButton: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;clearLabelExp: &quot;fieldLabel +' '+i18n('--cpr-clear')&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;buttonLabelExp: &quot;fieldLabel +' '+i18n('--cpr-dateinput-button')&quot;&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;fileinput: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;showClearButton: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;buttonFocusable: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;clearLabelExp: &quot;fieldLabel + ' '+i18n('--cpr-clear')&quot;&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;fileupload: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;emptyMessage: &quot;여기를 더블 클릭 또는 파일을 드래그 하세요&quot;&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;grid: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;tabMode: &quot;focusable&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;clickMode: &quot;edit&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;focusCycle: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;noDataMessage: &quot;표시할 데이터가 없습니다&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;viewingMode: &quot;button&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;//&#x9;&#x9;&#x9;wholeRenderingMode: true&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;inputbox: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;buttonFocusable: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;showClearButton: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;clearLabelExp: &quot;fieldLabel + ' '+i18n('--cpr-clear')&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;maskeditor: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;showClearButton: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;buttonFocusable: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;clearLabelExp: &quot;fieldLabel + ' '+i18n('--cpr-clear')&quot;&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;mdifolder: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;//&#x9;&#x9;&#x9;tabsWithAutoSelection: false&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;navigationbar: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;tabTraversal: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;expandTrigger: &quot;click&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;menuType: &quot;accessiblemegamenu&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;displayExp: &quot;label + sstr(depth + \&quot;단계\&quot;, [\&quot;cl-sound-only\&quot;])&quot;&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;numbereditor: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;buttonFocusable: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;showClearButton: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;clearLabelExp: &quot;fieldLabel + ' '+i18n('--cpr-clear')&quot;&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;progress: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;displayExp: &quot;sstr(\&quot;진행상황: \&quot;+self.max+\&quot;% 중 현재 \&quot;, [\&quot;cl-sound-only\&quot;]) + value + sstr(\&quot;% 진행 중\&quot;, [\&quot;cl-sound-only\&quot;])&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;showText: true&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;searchinput: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;buttonFocusable: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;hideClearButton: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;hideSearchButton: false,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;searchLabelExp: &quot;fieldLabel + ' '+i18n('--cpr-search')&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;clearLabelExp: &quot;fieldLabel + ' '+i18n('--cpr-clear')&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;tabfolder: {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;//&#x9;&#x9;&#x9;tabsWithAutoSelection: false&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;};" type="string"/>
        <cl:property name="title" value="defaults.js" type="string"/>
      </cl:udc>
