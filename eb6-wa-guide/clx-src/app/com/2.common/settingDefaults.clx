            <cl:output std:sid="output-8c74455b">
              <cl:expbind property="class" category="CLASS" expression="(REQ_YN == &quot;Y&quot; ? &quot;text-indigo fw-medium bg-primary-dim&quot; : &quot;&quot;) + &quot; text-center&quot;"/>
              <cl:celldata std:sid="c-data-33c1ec8f"/>
            </cl:output>
          </cl:gridcell>
