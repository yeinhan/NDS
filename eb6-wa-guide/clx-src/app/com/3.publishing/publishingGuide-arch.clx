        </cl:group>
        <cl:output std:sid="output-d37013f8" class="text-red" value="" displayexp="&quot;※ 링크드 리스트 박스의 [ &quot;&#xD;&#xA;+ sstr(&quot;hasChild / hasParent / hasBoth&quot;, [&quot;fw-bold&quot;])&#xD;&#xA;+ &quot; ] 는 각각 [ &quot;&#xD;&#xA;+ sstr(&quot;하위 요소 보유 / 상위 요소 보유 / 상하위 요소 모두 보유&quot;, [&quot;fw-bold&quot;])&#xD;&#xA;+ &quot; ]를 나타내기 위해 사용된 텍스트로 정해진 값이 아닙니다.&quot;">
          <cl:verticaldata std:sid="v-data-a45d0034" width="100px" height="18px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-a130cafc" spacing="5"/>
      </cl:group>
