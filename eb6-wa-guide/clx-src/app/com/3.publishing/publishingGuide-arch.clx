            <cl:verticaldata std:sid="v-data-89c024b5" width="1126px" height="240px" autosize="height"/>
            <cl:output std:sid="output-8e06b3ba" displayexp="&quot;가상 요소를 사용하여 텍스트 이외의 content를 제공하는 경우, 가상 커서가 이를 인식하고 접근하여 읽으므로 &quot;+sstr(&quot;사용을 지양해야합니다&quot;, [&quot;text-red fw-bold&quot;])+&quot;.\n&quot;&#xD;&#xA;+&quot; - &quot;+sstr(&quot;position : absolute&quot;, [&quot;fw-bold&quot;])+&quot; 사용 시 가상요소와 텍스트를 모두 커서가 이동되어 스크린 리더 사용 시 이해에 방해가 될 수 있습니다\n&quot;&#xD;&#xA;+&quot; - 불가피하게 사용해야하는 경우에는 &quot;+sstr(&quot;position : relative&quot;, [&quot;fw-bold&quot;])+&quot; 를 사용합니다&quot;">
              <cl:formdata std:sid="f-data-97c3d63d" row="0" col="0"/>
            </cl:output>
            <cl:output std:sid="output-c34bbf74" value="&#xD;&#xA;  - :before&#xD;&#xA;  - :after" displayexp="sstr(&quot;가상 요소 &quot;, [&quot;fw-bold&quot;]) +text">
