  <body std:sid="body-2d34bd2e">
    <cl:listener std:sid="listener-687c73c7" name="init" handler="onBodyInit"/>
    <cl:listener std:sid="listener-42e31325" name="load" handler="onBodyLoad2"/>
    <cl:udc std:sid="ud-control-27c2a286" id="breadcrumbs1" type="udc.pb.Breadcrumbs">
      <cl:verticaldata std:sid="v-data-d3766577" width="1180px" height="174px" autosize="height"/>
      <cl:property name="title" value="퍼블리싱 접근성 가이드 - 기획" type="string"/>
    </cl:udc>
    <cl:group std:sid="group-6c4646a5" id="grpInfo" class="bg-primary-dim">
      <cl:verticaldata std:sid="v-data-bc4a348e" width="400px" height="150px" autosize="height"/>
      <cl:output std:sid="output-a5bbbbb2" value="본 화면에서는 기획 단계에서 웹 접근성을 준수하는 화면을 작성하기 위한 가이드를 제공합니다. &#xD;&#xA;&#xD;&#xA;1. 디자인적 접근성 준수 사항&#xD;&#xA;2. 키보드 사용 보장&#xD;&#xA;3. 컨트롤 조작법 가이드 제공&#xD;&#xA;4. 스크린 리더 사용자의 컨텐츠 인식 개선&#xD;&#xA;5. 초점 이동">
        <cl:verticaldata std:sid="v-data-89cd7f2b" width="100px" height="120px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-e2a63d96" leftmargin="15" rightmargin="15" topmargin="15" bottommargin="15"/>
    </cl:group>
    <cl:group std:sid="group-d3c8ba75" id="grpArch1" class="border rounded">
      <cl:verticaldata std:sid="v-data-0e8b8c13" width="884px" height="2842px" autosize="height"/>
      <cl:udc std:sid="ud-control-392b571a" id="sectiontitle1" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-4508bfac" width="1180px" height="29px" autosize="none"/>
