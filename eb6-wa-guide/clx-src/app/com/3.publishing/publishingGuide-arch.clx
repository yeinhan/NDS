      <cl:udc std:sid="ud-control-b725de86" id="sectiontitle2" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-331fb6bb" width="1180px" height="29px" autosize="none"/>
        <cl:property name="title" value="2. 키보드 사용 보장" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-5ab38be5" value="키보드 사용을 보장하기 위해 고려해야 할 점을 가이드합니다.&#xD;&#xA;&#xD;&#xA;2-1. 키보드 사용 시 이용/인식이 어려운 요소는 지양&#xD;&#xA;2-2. 마우스에서만 조작 가능한 기능은 지양&#xD;&#xA;2-3. 선택 목적 그리드는 체크박스/라디오버튼 특수 컬럼 사용">
        <cl:verticaldata std:sid="v-data-451efab8" width="1198px" height="112px" autosize="height"/>
      </cl:output>
