            <cl:verticaldata std:sid="v-data-8bb0af0e" width="1116px" height="134px" autosize="height"/>
            <cl:output std:sid="output-1362761f" value="키보드로 조작할 때 사용자가 사용하기 어렵거나, 인식하기 어려운 기능은 제공하지 않아야 합니다. ">
              <cl:formdata std:sid="f-data-281559e9" row="0" col="0"/>
            </cl:output>
            <cl:group std:sid="group-c2a8253f" id="grp34" class="form-box-1px">
              <cl:formdata std:sid="f-data-cbed9fe5" height="77" row="1" col="0"/>
              <cl:output std:sid="output-11b17929" class="text-center fw-medium" value="&lt;데이트 인풋에 별도 증감 버튼을 제공하는 예제>">
                <cl:formdata std:sid="f-data-b1af53ef" row="0" col="0" rowspan="1" colspan="2"/>
              </cl:output>
              <cl:group std:sid="group-9625f4e2" id="grp56">
                <cl:formdata std:sid="f-data-eb1bb45b" topSpacing="10" bottomSpacing="10" leftSpacing="10" rightSpacing="10" row="1" col="0" rowspan="1" colspan="1"/>
                <cl:dateinput std:sid="d-input-83a8ef10" id="dtiExample" fieldLabel="데이트 인풋" value="20231010">
                  <cl:flowlayoutdata std:sid="f-data-0a6218a6" width="150px" height="30px"/>
                </cl:dateinput>
                <cl:button std:sid="button-4dd022f9" id="btn2" fieldLabel="날짜 증가" tooltip="날짜 증가" value="+">
                  <cl:listener std:sid="listener-4949d1ac" name="click" handler="onBtn2Click"/>
                  <cl:flowlayoutdata std:sid="f-data-9b55c483" width="30px" height="30px" autosize="width"/>
                </cl:button>
                <cl:button std:sid="button-598eee18" id="btn3" fieldLabel="날짜 감소" tooltip="날짜 감소" value="-">
                  <cl:listener std:sid="listener-950faeb6" name="click" handler="onBtn3Click"/>
                  <cl:flowlayoutdata std:sid="f-data-4651db9b" width="30px" height="30px" autosize="width"/>
                </cl:button>
                <cl:flowlayout std:sid="f-layout-371aa4b1" valign="middle"/>
              </cl:group>
              <cl:output std:sid="output-0c87c2ad" value="좌측 예제와 같이 별도 날짜 증감 버튼을 제공하면, 스크린 리더 사용자는 변경된 데이트 인풋의 값을 인식할 수 없으므로 예시와 같은 구조의 " displayexp="text + sstr(&quot;사용을 지양해야합니다.&quot;, [&quot;text-red fw-bold&quot;])">
                <cl:formdata std:sid="f-data-83a6917c" topSpacing="10" bottomSpacing="10" leftSpacing="10" rightSpacing="10" row="1" col="1"/>
              </cl:output>
