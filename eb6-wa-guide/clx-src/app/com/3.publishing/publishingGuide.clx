  <body std:sid="body-2d34bd2e">
    <cl:listener std:sid="listener-687c73c7" name="init" handler="onBodyInit"/>
    <cl:listener std:sid="listener-42ee4534" name="load" handler="onBodyLoad"/>
    <cl:udc std:sid="ud-control-27c2a286" id="breadcrumbs1" type="udc.pb.Breadcrumbs">
      <cl:verticaldata std:sid="v-data-d3766577" width="1180px" height="174px" autosize="height"/>
      <cl:property name="title" value="퍼블리싱 접근성 가이드 - 개발자" type="string"/>
    </cl:udc>
    <cl:group std:sid="group-6c4646a5" id="grp1" class="bg-primary-dim">
      <cl:verticaldata std:sid="v-data-bc4a348e" width="400px" height="176px" autosize="height"/>
      <cl:output std:sid="output-a5bbbbb2" value="본 화면에서는 퍼블리싱 단계에서 개발자가 웹 접근성을 준수하는 화면을 작성하기 위한 가이드를 제공합니다. &#xD;&#xA;&#xD;&#xA;1. 접근성 검토 모드&#xD;&#xA;2. 마크업 순서 정렬&#xD;&#xA;3. 라벨링/대체 텍스트 제공&#xD;&#xA;4. 공통 속성 설정&#xD;&#xA;5. 조회형 리스트 사용 기준">
        <cl:verticaldata std:sid="v-data-89cd7f2b" width="100px" height="146px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-e2a63d96" leftmargin="15" rightmargin="15" topmargin="15" bottommargin="15"/>
    </cl:group>
    <cl:group std:sid="group-d3c8ba75" id="grp7" class="border rounded">
      <cl:verticaldata std:sid="v-data-0e8b8c13" width="400px" height="795px" autosize="height"/>
      <cl:udc std:sid="ud-control-392b571a" id="sectiontitle1" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-4508bfac" width="1180px" height="29px" autosize="none"/>
