          <cl:output std:sid="output-a7cea4b2" displayexp="&quot;디자인 편집기 상에서도 컨트롤을 선택하고 단축키를 통해 Outline 뷰의 정렬 순서를 변경할 수 있습니다. \n\n&quot;&#xD;&#xA;+ sstr(&quot; - 단축키 : 디자인 편집기에서 Ctrl+Shift+ '[' 또는 ']'키로 순서를 변경할 수 있습니다&quot;, [&quot;text-success&quot;])">
            <cl:formdata std:sid="f-data-52732563" row="1" col="2"/>
          </cl:output>
          <cl:img std:sid="image-e2f361da" id="img1" src="퍼블리싱가이드 캡쳐 이미지/2-2. 마크업순서_디자인 편집기 순서변경jpg.jpg" alt="Outline 뷰 수정">
            <cl:formdata std:sid="f-data-dcade98c" halign="CENTER" valign="CENTER" width="246" height="102" row="1" col="0"/>
          </cl:img>
          <cl:output std:sid="output-eb76dc9a" class="label" value="Outline 뷰에서 수정">
            <cl:formdata std:sid="f-data-a1d6730f" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-44184df4" displayexp="&quot;'표시순으로 자식 정렬' 기능으로 정렬된 순서가 &quot;+sstr(&quot;기획된 의도나 접근성에 부합하지 않는 경우&quot;, [&quot;fw-bold&quot;]) + &quot; Outline에서 직접 순서를 변경합니다.\n\n&quot; &#xD;&#xA;+sstr(&quot; - 단축키 : Outline 뷰에서 Ctrl+↑/↓ 키로 순서를 변경할 수 있습니다&quot;, [&quot;text-success&quot;])">
            <cl:formdata std:sid="f-data-7f9f4cea" row="0" col="2"/>
          </cl:output>
