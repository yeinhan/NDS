            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-ee4c814e" value="웹 접근성 준수를 위해 공통모듈에서는 아래 스타일 클래스 적용 여부에 따라 자동으로 접근성 레이블을 설정합니다.&#xD;&#xA;화면 기능에 따라 다음 스타일 클래스가 적용이 되었는지 반드시 확인하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-d1f02bff" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-56156087" id="grp44" class="form-base">
          <cl:verticaldata std:sid="v-data-e9dcc762" width="1158px" height="342px" autosize="height"/>
          <cl:output std:sid="output-47832263" class="label" value="클래스명">
            <cl:formdata std:sid="f-data-4422b73d" row="0" col="0"/>
          </cl:output>
