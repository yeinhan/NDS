      </cl:udc>
      <cl:group std:sid="group-6df17ff1" id="grp38">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-7681952c" width="1178px" height="173px" autosize="height"/>
        <cl:group std:sid="group-b9e04ce2" id="grp39">
          <cl:verticaldata std:sid="v-data-e504d485" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-07499826" id="udccomformtitle10" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-d3566456" row="0" col="0"/>
            <cl:property name="title" value="3-1. 마우스 이벤트" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-cac4fbb9" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-f4b9fed4" value="마우스로 동작하는 기능은 키보드를 통해서도 동일하게 동작할 수 있어야 합니다.&#xD;&#xA;따라서, 마우스만 동작하는 이벤트는 사용을 지양해야 합니다.">
          <cl:verticaldata std:sid="v-data-3a718173" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-30fafdb7" class="text-danger ff-italic" value="※ 대표적인 마우스 이벤트 : 우클릭(contextmenu), 드래그 앤 드롭(dragenter, dragover, dragleave, drop) 등...">
          <cl:verticaldata std:sid="v-data-a038368b" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-a4bf4d90" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:group std:sid="group-623cca4a" id="grp47">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-b594fffa" width="1178px" height="334px" autosize="height"/>
        <cl:group std:sid="group-5a80a821" id="grp48">
          <cl:verticaldata std:sid="v-data-93620fd7" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-92e74e92" id="udccomformtitle13" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-d8d22a0b" row="0" col="0"/>
            <cl:property name="title" value="3-2. 화면 로드 이벤트" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-0145f518" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-951d6285" value="다음 설명은 그리드가 존재하는 화면일 경우 해당됩니다.&#xD;&#xA;&#xD;&#xA;eXBuilder6에서 제공하는 공통모듈 기능 중, 그리드 데이터가 로드될 경우 그리드로 포커스가 이동하도록 제공하고 있습니다.&#xD;&#xA;최초 화면 로드(onBodyLoad) 이벤트에서 데이터 조회 시, 초점이 화면의 처음이 아닌 그리드로 위치하게 되기 때문에 접근성에 위배될 수 있습니다.&#xD;&#xA;&#xD;&#xA;따라서 그리드가 존재하는 모든 화면에서는 다음 둘 중 한가지 방안을 반드시 선택해주시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-19fff2d4" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-e400acf0" id="grp49" class="form-base">
          <cl:verticaldata std:sid="v-data-0b0daaaa" width="1158px" height="162px" autosize="height"/>
          <cl:output std:sid="output-9bbfcad1" class="label" value="방법1">
            <cl:formdata std:sid="f-data-0c4b81aa" row="0" col="0"/>
          </cl:output>
          <cl:output std:sid="output-323e2c90" value="화면 로드 이벤트에서 데이터 조회 금지&#xD;&#xA;&#xD;&#xA;※ 반드시 조회버튼의 click 이벤트를 통해 데이터 조회">
            <cl:formdata std:sid="f-data-066db3f1" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-f2d264f6" class="label" value="방법2">
            <cl:formdata std:sid="f-data-2e7eb758" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-c7997911" value="그리드 조회 시, 그리드 포커스 스크립트 제거&#xD;&#xA;&#xD;&#xA;※ 공통담당자 확인 필요&#xD;&#xA;※ 수정 위치 : extension.module.js 의 GridKit.prototype.init 확인">
            <cl:formdata std:sid="f-data-25ef8dd8" row="1" col="1"/>
          </cl:output>
