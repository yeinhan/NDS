            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-0d841cfd" value="ariaButtonType 속성 설정에 대한 자세한 설명은 아래 버튼을 클릭하여 확인하십시오.">
          <cl:verticaldata std:sid="v-data-5d2996c1" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-e276cca6" id="grp26">
          <cl:verticaldata std:sid="v-data-5277f7fb" width="1158px" height="30px" autosize="height"/>
          <cl:button std:sid="button-faa4d2bd" id="btn3" class="btn-outline-primary" value="[Button - ariaButtonType] 사용방법 바로가기">
            <cl:listener std:sid="listener-6e9ae151" name="click" handler="onBtn1Click"/>
            <cl:attribute name="movePage" value="button"/>
            <cl:flowlayoutdata std:sid="f-data-4dee1448" width="350px" height="30px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-826faa65" scrollable="false"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-5a0eb31a" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:group std:sid="group-b2533427" id="grp27">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-26508dc4" width="1178px" height="213px" autosize="height"/>
        <cl:group std:sid="group-041ec3a1" id="grp28">
          <cl:verticaldata std:sid="v-data-c931c382" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-289994f1" id="udccomformtitle8" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-e41259fe" row="0" col="0"/>
            <cl:property name="title" value="2-2. 아웃풋 - outputType" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-3568dd8b" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-d3d9ca10" value="헤딩 태그(h1 ~ h6) 를 지원하는 아웃풋 속성입니다.&#xD;&#xA;스크린리더 사용시에 헤딩 태그 간 이동이 가능하므로, 사용자 편의성을 높일 수 있습니다.&#xD;&#xA;타이틀로 배치되는 아웃풋에 적용해야 하며, 화면 내 헤딩 구조에 맞춰 적용하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-e39e4549" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-f5da891a" value="outputType 속성 설정에 대한 자세한 설명은 아래 버튼을 클릭하여 확인하십시오.">
          <cl:verticaldata std:sid="v-data-e2b52a9f" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-4a51f528" id="grp30">
          <cl:verticaldata std:sid="v-data-83f5c977" width="1158px" height="30px" autosize="height"/>
          <cl:button std:sid="button-137bd24b" id="btn4" class="btn-outline-primary" value="[Output - outputType] 사용방법 바로가기">
            <cl:listener std:sid="listener-f1f10895" name="click" handler="onBtn1Click"/>
            <cl:attribute name="movePage" value="output"/>
            <cl:flowlayoutdata std:sid="f-data-c3af9f10" width="350px" height="30px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-e1fa3a39" scrollable="false"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-43a57ec9" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:group std:sid="group-3e450f07" id="grp29">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-caa83867" width="1178px" height="1543px" autosize="height"/>
        <cl:group std:sid="group-dcda850b" id="grp31">
          <cl:verticaldata std:sid="v-data-8a1ea964" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-bbf6a518" id="udccomformtitle9" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-b97de873" row="0" col="0"/>
            <cl:property name="title" value="2-3. 그리드" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-3339fb94" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-d121a29c" class="fw-bold" value="2-3-1. 정렬, 필터 기능 사용 지양">
          <cl:verticaldata std:sid="v-data-018061d3" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-71f34d77" value="그리드 헤더에서 제공하는 정렬, 필터 기능을 키보드로 접근이 불가능 하기 때문에 사용하는 것을 지양해야 합니다.&#xD;&#xA;&#xD;&#xA;디자인편집기에서 그리드에 드래그 앱 드롭을 통해 데이터 셋을 연동 시, 그리드  생성창에서 소트, 필터를 넣지 않도록 주의하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-216e5451" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-e09c8678" id="grp32" class="form-base">
          <cl:verticaldata std:sid="v-data-86598905" width="1158px" height="162px" autosize="height"/>
          <cl:group std:sid="group-06701550" id="grp34">
            <cl:formdata std:sid="f-data-f8ebe9b1" halign="FILL" valign="FILL" width="280" height="167" topSpacing="10" bottomSpacing="10" leftSpacing="10" rightSpacing="10" row="0" col="0"/>
            <cl:img std:sid="image-cb574d3c" id="img2" src="image/grid_sort_filter_property.png" alt="접근성 검토모드 팔레트뷰">
              <cl:formdata std:sid="f-data-7459911e" row="0" col="0"/>
            </cl:img>
            <cl:formlayout std:sid="f-layout-c0e41440" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
              <cl:rows length="1" unit="FRACTION"/>
              <cl:columns length="1" unit="FRACTION"/>
            </cl:formlayout>
          </cl:group>
          <cl:output std:sid="output-17230010" class="label" value="그리드 편집기">
            <cl:formdata std:sid="f-data-9d45e048" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-9fc9e712" value="그리드를 더블클릭하면 그리드 편집기로 진입합니다.&#xD;&#xA;각 그리드 셀을 선택하면 Properties뷰에서 그리드 셀에 관련된 속성을 확인 할 수 있습니다.&#xD;&#xA;&#xD;&#xA;그리드 셀의 sortable, filterable 속성이 모두 false 로 설정되어 있는지 확인하시기 바랍니다.">
            <cl:formdata std:sid="f-data-afa4baf8" row="0" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-6d25cf9e" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="280" unit="PIXEL" autoSizing="false" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-44ac5572" class="fw-bold mt-5" value="2-3-2. selection-change 이벤트">
          <cl:verticaldata std:sid="v-data-140396b0" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-91f7ee14" value="웹 접근성 지침을 준수하기 위해서, 사용자가 의도하지 않은 기능은 동작해서는 안됩니다.&#xD;&#xA;&#xD;&#xA;즉, 그리드의 selection-change 이벤트에 의미 있는 기능을 구현할 경우, 사용자가 의도하지 않았는데도 해당 이벤트가 동작하여 접근성에 위배가 될 수 있습니다.&#xD;&#xA;따라서 그리드의 selection-change 이벤트를 통해 기능을 구현하는 것을 지양하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-e0e50465" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-b48ad0a8" class="text-danger ff-italic" value="※ 주의사항&#xD;&#xA;selection-change 이벤트를 제공하는 다른컨트롤도 마찬가지로 주의하여 사용하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-728ad1ce" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-c823731b" class="fw-bold mt-5" value="2-3-3. cell-click 이벤트">
          <cl:verticaldata std:sid="v-data-902c436a" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-fb948d60" value="특정 셀에서 동작하는 기능은 cell-click 이벤트를 사용할 것을 권장합니다.&#xD;&#xA;&#xD;&#xA;cell-click 이벤트는 기본적으로 마우스와 Enter 키를 모두 지원하고 있으며, 이벤트 객체에서 셀에 대한 정보를 제공하고 있습니다.">
          <cl:verticaldata std:sid="v-data-c028b2de" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-c7b3b4a4" id="grp35" class="form-base">
          <cl:verticaldata std:sid="v-data-eddf0c28" width="1158px" height="162px" autosize="height"/>
          <cl:udc std:sid="ud-control-1e2e917a" id="udcexamace4" type="udc.exam.udcExamAce">
            <cl:formdata std:sid="f-data-43a3057a" row="0" col="0"/>
            <cl:property name="value" value="/*&#xD;&#xA; * 그리드에서 cell-click 이벤트 발생 시 호출.&#xD;&#xA; * Grid의 Cell 클릭시 발생하는 이벤트.&#xD;&#xA; */&#xD;&#xA;function onGrd1CellClick(e) {&#xD;&#xA;&#x9;var grd1 = e.control;&#xD;&#xA;&#x9;// cell 정보 확인(cellBoundingRect, relativeTargetName, row, rowIndex, cellIndex, columnName)&#xD;&#xA;&#x9;var targetObject = e.targetObject;&#xD;&#xA;}" type="string"/>
          </cl:udc>
          <cl:output std:sid="output-a1e29644" class="label" value="스크립트 예시">
            <cl:formdata std:sid="f-data-1671b45d" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-23535ec1" value="그리드 cell-click 이벤트 객체에서 targetObject 를 통해 셀에 대한 정보를 확인할 수 있습니다.">
            <cl:formdata std:sid="f-data-57616ca3" row="0" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-b7e2c70b" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-948a2f08" class="text-danger ff-italic" value="※ 주의사항&#xD;&#xA;그리드의 click 이벤트는 그리드 전용 이벤트가 아니기 때문에 셀 정보를 제공하지 않습니다.&#xD;&#xA;그리드의 click 이벤트가 아닌 cell-click 이벤트를 사용하도록 주의하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-08d32e13" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-bf77edc5" class="fw-bold mt-5" value="2-3-4. 읽기전용 그리드">
          <cl:verticaldata std:sid="v-data-a6a893d3" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-cc184fd8" value="읽기전용 그리드는 그리드 셀에 편집이 가능하거나, 이벤트가 동작하는 컨트롤이 없는 경우에만 설정해야 합니다.&#xD;&#xA;즉, 그리드 편집기에서 셀에 컨트롤이 배치되어 있지 않거나, 아웃풋이 배치되어 있는 경우에만 readOnly=true 를 설정하도록 하며, 그 외에는 readOnly=false(기본값) 을 유지합니다.">
          <cl:verticaldata std:sid="v-data-b9be3498" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-e2bfcdf5" id="grp36" class="form-base">
          <cl:verticaldata std:sid="v-data-6e486108" width="1158px" height="162px" autosize="height"/>
          <cl:output std:sid="output-a59f4360" class="label" value="readOnly=false">
            <cl:formdata std:sid="f-data-b0dca27d" row="0" col="0"/>
          </cl:output>
          <cl:output std:sid="output-8a4ef8ed" value="(default) 조회용 그리드를 제외한 모든 경우에 적용">
            <cl:formdata std:sid="f-data-342b50cb" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-3ab2c9a1" class="label" value="readOnly=true">
            <cl:formdata std:sid="f-data-bba76a58" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-bf4980cc" value="그리드 기본 셀 또는 아웃풋만 배치되어 있는 경우 적용">
            <cl:formdata std:sid="f-data-3980e7ad" row="1" col="1"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-c67acede" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-e201237e" value="그리드에 대한 자세한 설명은 아래 버튼을 클릭하여 확인하십시오.">
          <cl:verticaldata std:sid="v-data-aecc966e" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-3b5767de" id="grp37">
          <cl:verticaldata std:sid="v-data-c783a33d" width="1158px" height="30px" autosize="height"/>
          <cl:button std:sid="button-f2c2b126" id="btn5" class="btn-outline-primary" value="[Grid] 사용방법 바로가기">
            <cl:listener std:sid="listener-3b76831f" name="click" handler="onBtn1Click"/>
            <cl:attribute name="movePage" value="grid"/>
            <cl:flowlayoutdata std:sid="f-data-e9612316" width="350px" height="30px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-0816b6e8" scrollable="false"/>
        </cl:group>
        <cl:output std:sid="output-a557a27a" class="fw-bold mt-5" value="2-3-5. 그룹핑 그리드">
          <cl:verticaldata std:sid="v-data-89d910ab" width="1178px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-c56fe09f" value="웹 접근성에서는 그룹핑 그리드를 권장하지는 않습니다.&#xD;&#xA;단, 그룹핑 그리드를 사용하고자 하실 경우에는 그리드에서 제공하는 그룹핑 기능이 아닌, 트리셀 컨트롤을 통해 그룹핑을 적용해야 합니다.">
          <cl:verticaldata std:sid="v-data-323c0797" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-e45f890d" value="트리셀을 활용한 그룹핑 그리드 설정방법에 대한 자세한 설명은 아래 버튼을 클릭하여 확인하십시오.">
          <cl:verticaldata std:sid="v-data-f140038f" width="1178px" height="30px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-4ddd9f77" id="grp50">
          <cl:verticaldata std:sid="v-data-2c7623fc" width="1178px" height="30px" autosize="height"/>
          <cl:button std:sid="button-8cff8ba6" id="btn6" class="btn-outline-primary" value="[Grid] 그룹핑 그리드 설명 바로가기">
            <cl:listener std:sid="listener-056dd607" name="click" handler="onBtn1Click"/>
            <cl:attribute name="movePage" value="grid"/>
            <cl:flowlayoutdata std:sid="f-data-a945ff7a" width="350px" height="30px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-e4d4265f" scrollable="false"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-c21cb7a9" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-8ab3a8f5" spacing="10" leftmargin="20" rightmargin="20" topmargin="20" bottommargin="20"/>
    </cl:group>
    <cl:group std:sid="group-dc286c8f" id="grp21" class="border rounded">
      <cl:verticaldata std:sid="v-data-a3de964a" width="1220px" height="672px" autosize="height"/>
      <cl:udc std:sid="ud-control-e93f3eee" id="sectiontitle3" type="udc.pb.SectionTitle">
