          </cl:udc>
          <cl:formlayout std:sid="f-layout-74b2d3f2" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-1e80a092" value="접근성 검토 모드는 eXBuilder6의 [Palette] 뷰의 [도구] 탭에서 선택하여 사용할 수 있습니다.&#xD;&#xA;&#xD;&#xA;접근성 검토모드를 활성할 경우, 디자인 편집기에서 접근성과 관련한 메뉴를 제공하고 있으며, 접근성 라벨링 검토기능을 제공하고 있습니다.">
          <cl:verticaldata std:sid="v-data-6122da39" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-37dd22b3" id="grp33" class="form-base">
          <cl:verticaldata std:sid="v-data-4c1afd65" width="1158px" height="162px" autosize="height"/>
          <cl:group std:sid="group-3663cf13" id="grp120">
            <cl:formdata std:sid="f-data-47bee2c3" halign="CENTER" valign="CENTER" width="280" height="167" topSpacing="10" bottomSpacing="10" leftSpacing="10" rightSpacing="10" row="0" col="0"/>
            <cl:img std:sid="image-12ac26ec" id="img1-1" src="../3.publishing/퍼블리싱가이드 캡쳐 이미지/1-1. 접근성 검토모드-Palette뷰.jpg" alt="접근성 검토모드 팔레트뷰">
              <cl:formdata std:sid="f-data-14989768" row="0" col="0"/>
            </cl:img>
            <cl:formlayout std:sid="f-layout-206ca2c2" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
              <cl:rows length="1" unit="FRACTION"/>
              <cl:columns length="1" unit="FRACTION"/>
            </cl:formlayout>
          </cl:group>
          <cl:output std:sid="output-0c2806c1" class="label" value="palette 뷰">
            <cl:formdata std:sid="f-data-2955e5dd" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-ea315772" value=" eXBuilder6의 [Palette] 뷰의 [도구] 탭에서 에서 선택하여 사용할 수 있습니다.">
            <cl:formdata std:sid="f-data-0767dd55" row="0" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-9466592d" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
