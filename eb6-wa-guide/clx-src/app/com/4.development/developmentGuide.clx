            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-dd185e9f" class="fw-bold mt-5" value="4-2-1. 컨트롤 숨김 처리시 주의사항">
          <cl:verticaldata std:sid="v-data-0aeed7f0" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-70f7432e" class="text-danger" value="컨트롤을 보이지 않도록 할 때, visible 속성이 아닌 다른 방법을 통해서 숨기는 방법을 사용해서는 안됩니다.">
          <cl:verticaldata std:sid="v-data-0a49e639" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-4c6420ca" value="※ 컨트롤 숨김 처리시 하지 말아야 할 상황 예시&#xD;&#xA;- CSS 속성(visibility: hidden, opacity: 0, background: transparent 등...) 으로 숨김 처리 하는 방식&#xD;&#xA;- 컨트롤의 위치를 화면 밖으로 이동하거나, 사이즈를 0px로 설정하여 숨김 처리 하는 방식">
          <cl:verticaldata std:sid="v-data-43c5a756" width="1158px" height="75px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-a946751c" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
