            <cl:formdata std:sid="f-data-d34842b4" row="0" col="0"/>
          </cl:output>
          <cl:output std:sid="output-1e3ccc06" class="label" value="적용하는 경우">
            <cl:formdata std:sid="f-data-eb69d93b" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-a217e9d9" value="button">
            <cl:formdata std:sid="f-data-59b7836e" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-34618a43" value="(default) 화면 내에서 동작하는 경우 적용">
            <cl:formdata std:sid="f-data-11f9febe" row="1" col="1"/>
          </cl:output>
          <cl:output std:sid="output-3e37f6e8" value="link">
            <cl:formdata std:sid="f-data-a302a7d7" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-bce14a32" value="- 외부 새 창을 띄우는 경우 적용&#xD;&#xA;- URL이 변경되는 경우 적용">
            <cl:formdata std:sid="f-data-24a6f2cd" row="2" col="1"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-c30bfeab" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="30" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
