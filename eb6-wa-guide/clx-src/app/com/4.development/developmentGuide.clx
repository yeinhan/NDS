          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-9e05c8e5" value="[접근성 검토 모드]에 대한 자세한 설명은 아래 버튼을 클릭하여 확인하십시오.">
          <cl:verticaldata std:sid="v-data-daba83e1" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-20daae0f" id="grp4">
          <cl:verticaldata std:sid="v-data-67d90ce4" width="1158px" height="30px" autosize="height"/>
          <cl:button std:sid="button-0613747d" id="btn1" class="btn-outline-primary" value="[접근성 검토 모드] 사용 방법 바로가기">
