          </cl:output>
          <cl:output std:sid="output-40a61464" value="필수 입력 항목 클래스&#xD;&#xA;⇒ “필수입력” 레이블 추가&#xD;&#xA;⇒ 대상 : 인풋 계열 컨트롤">
            <cl:formdata std:sid="f-data-db7d2dd2" row="1" col="1"/>
          </cl:output>
          <cl:output std:sid="output-fa27f8c9" value="btn-expanded ">
            <cl:formdata std:sid="f-data-61641988" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-81ff1534" value="하위 내용을 토글(접고 펼치는 기능)하는 버튼&#xD;&#xD;&#xA;⇒ “축소됨” 레이블 추가&#xD;&#xD;&#xA;⇒ 대상 : 버튼">
            <cl:formdata std:sid="f-data-fa8713cd" row="2" col="1"/>
          </cl:output>
          <cl:output std:sid="output-9630e306" value="expand">
