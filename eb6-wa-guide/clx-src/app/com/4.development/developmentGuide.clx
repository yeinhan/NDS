      <cl:group std:sid="group-f60c56a4" id="grp42">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-9c8db35d" width="1178px" height="470px" autosize="height"/>
        <cl:group std:sid="group-3bdf67a3" id="grp43">
          <cl:verticaldata std:sid="v-data-4c0a5a3e" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-65d20eae" id="udccomformtitle12" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-e1c57861" row="0" col="0"/>
            <cl:property name="title" value="4-2. 컨트롤 숨김 처리" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-c9e90c45" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-0b87b7ba" value="스크린리더를 사용할 경우, DOM에 그려진 모든 요소에 접근이 가능합니다.&#xD;&#xA;따라서 시각적으로 보이지 않는 컨트롤은 반드시 visible=false 설정을 해야 합니다.">
          <cl:verticaldata std:sid="v-data-cad343b4" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-8310951c" id="grp45" class="form-base">
          <cl:verticaldata std:sid="v-data-686f61a6" width="1158px" height="162px" autosize="height"/>
          <cl:group std:sid="group-1b194abf" id="grp46">
            <cl:formdata std:sid="f-data-ca3fb26a" halign="FILL" valign="FILL" width="280" height="167" topSpacing="10" bottomSpacing="10" leftSpacing="10" rightSpacing="10" row="0" col="0"/>
            <cl:img std:sid="image-81f07d65" id="img3" src="image/visible.png" alt="접근성 검토모드 팔레트뷰">
              <cl:formdata std:sid="f-data-37dd10dc" row="0" col="0"/>
            </cl:img>
            <cl:formlayout std:sid="f-layout-81ad0a7c" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
              <cl:rows length="1" unit="FRACTION"/>
              <cl:columns length="1" unit="FRACTION"/>
            </cl:formlayout>
          </cl:group>
          <cl:output std:sid="output-b6d42b9f" class="label" value="Properties뷰">
            <cl:formdata std:sid="f-data-feeaac77" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-0e19f2f5" value="시각적으로 보이지 않는 요소는 반드시 visible=false 처리를 합니다.">
            <cl:formdata std:sid="f-data-5aad9c19" row="0" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-5567f781" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
