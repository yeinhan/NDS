        <cl:group std:sid="group-9cf2f372" id="grp24">
          <cl:verticaldata std:sid="v-data-2fb3cfae" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-7a44fe46" id="udccomformtitle7" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-f4bb8307" row="0" col="0"/>
            <cl:property name="title" value="2-1. 버튼 - ariaButtonType" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-985c4234" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-5249ff3b" value="ariaButtonType에 설정된 값에 따라 스크린리더가 버튼을 읽는 방식이 결정됩니다.&#xD;&#xA;기본적으로 button 을 설정하며, 이벤트 동작에 따라 link 를 적용하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-2aeba4ed" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-505bcaca" id="grp25" class="form-base">
          <cl:verticaldata std:sid="v-data-33de16f4" width="1158px" height="242px" autosize="height"/>
