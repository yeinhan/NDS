            <cl:flowlayoutdata std:sid="f-data-87eb76ad" width="300px" height="30px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-122ba938" scrollable="false"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-732a3d70" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:group std:sid="group-f04b4b54" id="grp5">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-a54a4a17" width="1178px" height="570px" autosize="height"/>
        <cl:group std:sid="group-fbdaabce" id="grp6">
          <cl:verticaldata std:sid="v-data-1096453f" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-51c30680" id="udccomformtitle3" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-98076404" row="0" col="0"/>
            <cl:property name="title" value="1-2. 접근성 검토모드(웹)" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-0ca99991" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-69e009e1" value="접근성 검토 모드 도구는 디자인 편집기에 배치된 컨트롤에 한해서 기능을 사용할 수 있습니다.&#xD;&#xA;&#xD;&#xA;동적으로 생성되는 컨트롤에 대해서도 확인하기 위해 다음 공통모듈에서 접근성 검토모드와 같은 기능을 제공합니다.&#xD;&#xA;* 공통모듈 : module/wa/checkAccessibilityProperty,module.js">
          <cl:verticaldata std:sid="v-data-386325df" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-eec8d49b" id="grp8" class="form-base">
          <cl:verticaldata std:sid="v-data-d883a08a" width="1158px" height="162px" autosize="height"/>
          <cl:udc std:sid="ud-control-4b2b88a6" id="udcexamace1" type="udc.exam.udcExamAce">
            <cl:formdata std:sid="f-data-7ff22efe" row="0" col="0"/>
            <cl:property name="value" value="/************************************************&#xD;&#xA; * TODO&#xD;&#xA; * 확인하고자 할 경우 아래 변수(mbUse) 를 true 로 설정하여 확인하십시오.&#xD;&#xA; * 운영배포시에는 반드시 본 모듈을 제거할 것을 권고드립니다.&#xD;&#xA; ************************************************/&#xD;&#xA;var mbUse = true;&#xD;&#xA;&#xD;&#xA;// ... (이하생략) ..." type="string"/>
          </cl:udc>
          <cl:output std:sid="output-ea6f66b9" class="label" value="공통모듈">
            <cl:formdata std:sid="f-data-c8e6fc79" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-9dbf8716" value="공통모듈 상단의 전역변수(mbUse) 를 true 로 선언할 경우에만 기능을 사용할 수 있습니다.">
            <cl:formdata std:sid="f-data-a2b85820" row="0" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-af80207d" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:group std:sid="group-6ecfab70" id="grp9" class="form-base">
          <cl:verticaldata std:sid="v-data-28965f5f" width="1158px" height="162px" autosize="height"/>
          <cl:group std:sid="group-54eac83d" id="grp10">
            <cl:formdata std:sid="f-data-3aaa3cff" row="0" col="0"/>
            <cl:img std:sid="image-c94b4308" id="img1" src="image/checkAccessibilityProperty.png" alt="접근성 검토모드 팔레트뷰">
              <cl:formdata std:sid="f-data-2b7d7ef7" row="0" col="0"/>
            </cl:img>
            <cl:formlayout std:sid="f-layout-33bfca1a" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
              <cl:rows length="1" unit="FRACTION"/>
              <cl:columns length="1" unit="FRACTION"/>
            </cl:formlayout>
          </cl:group>
          <cl:output std:sid="output-50645852" class="label" value="브라우저 확인">
            <cl:formdata std:sid="f-data-21bd27a2" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-ae1012f9" value="우측 상단에 &quot;웹접근성 확인&quot; 체크박스가 나타납니다.&#xD;&#xA;체크박스를 체크하여 현재 화면에 적용된 접근성 속성 적용 여부를 확인 할 수 있습니다.&#xD;&#xA;&#xD;&#xA;※ 모든 접근성 준수여부를 검사하는 것이 아닌 공통적으로 적용되는 fieldLabel, tooltip, alt 속성에 대한 검사를 진행합니다.&#xD;&#xA;※ 접근성 핸들에 마우스를 올려서(hover) 어떤 속성에 대한 내용인지 확인 할 수 있습니다.">
            <cl:formdata std:sid="f-data-896e52b0" row="0" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-040dba72" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-8373bd46" class="text-danger ff-italic" value="※ 공통모듈의 제공여부 및 위치는 프로젝트 별로 상이할 수 있습니다.">
          <cl:verticaldata std:sid="v-data-71ef13be" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-bb1c0b95" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:group std:sid="group-59c39d8f" id="grp11">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-145052d8" width="1178px" height="714px" autosize="height"/>
        <cl:group std:sid="group-b9740a64" id="grp12">
          <cl:verticaldata std:sid="v-data-51f51692" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-68ad796b" id="udccomformtitle4" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-ce30f808" row="0" col="0"/>
            <cl:property name="title" value="1-3. 탭 순서" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-8d81b53b" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-8401042d" class="fw-bold" value="1-3-1. 마크업 순서">
          <cl:verticaldata std:sid="v-data-41efa69b" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-1de82636" value="eXBuilder6에서 탭 순서는 HTML 마크업이 정렬된 순서로 결정됩니다.&#xD;&#xA;마크업 순서를 정렬하는 방법은 다음 두 가지 방법을 통해 설정 할 수 있습니다.&#xD;&#xA;&#xD;&#xA;1) 표시 순으로 자식 정렬&#xD;&#xA;2) Outline 뷰 설정">
          <cl:verticaldata std:sid="v-data-7676bb29" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-a76bfd13" value="[탭 순서]에 대한 자세한 설명은 아래 버튼을 클릭하여 확인하십시오.">
          <cl:verticaldata std:sid="v-data-4e702896" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-9f1db814" id="grp14">
          <cl:verticaldata std:sid="v-data-3e559fc0" width="1158px" height="30px" autosize="height"/>
          <cl:button std:sid="button-ec062ef5" id="btn2" class="btn-outline-primary" value="[마크업 순서] 사용 방법 바로가기">
            <cl:listener std:sid="listener-b0d65d94" name="click" handler="onBtn1Click"/>
            <cl:attribute name="movePage" value="PublishingGuide"/>
            <cl:flowlayoutdata std:sid="f-data-433d7501" width="300px" height="30px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-68462bee" scrollable="false"/>
        </cl:group>
        <cl:output std:sid="output-f2d8acae" class="fw-bold mt-5" value="1-3-2. 동적 컨트롤 추가">
          <cl:verticaldata std:sid="v-data-96380ea1" width="1158px" height="30px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-f58eca5f" value="동적으로 스크립트를 통해 컨트롤을 추가하는 경우에는 addChild()를 하게 되면 Outline 영역상의 마지막 DOM 으로 추가됩니다.&#xD;&#xA;따라서 중간에 컨트롤을 추가하기 위해서는 반드시 insertChlid() API 를 사용해야 합니다.">
          <cl:verticaldata std:sid="v-data-7c0608a5" width="1158px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-0330e5b4" id="grp13" class="form-base">
          <cl:verticaldata std:sid="v-data-6b9022cb" width="1158px" height="322px" autosize="height"/>
          <cl:udc std:sid="ud-control-0f1fff38" id="udcexamace2" type="udc.exam.udcExamAce">
            <cl:formdata std:sid="f-data-5d23833d" row="0" col="0" rowspan="2" colspan="1"/>
            <cl:property name="value" value="function insertChild() {&#xD;&#xA;&#x9;var container = new cpr.controls.Container();&#xD;&#xA;&#x9;var vcNewCtrl = new cpr.controls.Button();&#xD;&#xA;&#x9;container.insertChild(0, vcNewCtrl, {&#xD;&#xA;&#x9;&#x9;top: &quot;0px&quot;,&#xD;&#xA;&#x9;&#x9;left: &quot;0px&quot;,&#xD;&#xA;&#x9;&#x9;width: &quot;100px&quot;,&#xD;&#xA;&#x9;&#x9;height: &quot;30px&quot;&#xD;&#xA;&#x9;});&#xD;&#xA;}" type="string"/>
          </cl:udc>
          <cl:output std:sid="output-cd1f08f7" class="label" value="스크립트 예시">
            <cl:formdata std:sid="f-data-02bafb8d" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-d43a69f9" value="중간에 컨트롤을 추가해야 하는 경우에는 floatControl, addChlid 를 사용하지 않고, insertChild 를 사용하여 tabIndex 순서를 보장합니다.">
            <cl:formdata std:sid="f-data-468156f8" row="0" col="2"/>
          </cl:output>
          <cl:output std:sid="output-d7c97dd1" class="label text-danger" value="주의사항">
            <cl:formdata std:sid="f-data-7b7a5aec" row="1" col="1"/>
          </cl:output>
          <cl:output std:sid="output-0c293036" value="동일 화면 내 동일한 ID를 가진 컨트롤이 존재하면 안되므로,&#xD;&#xA;특수한 경우를 제외한 일반적인 경우엔 컨트롤 생성 시 ID를 지정하지 않는 것을 권장합니다." displayexp="text&#xD;&#xA;&#xD;&#xA;+ sstr(&quot;\n\n(예시)&quot;, [&quot;&quot;])&#xD;&#xA;+ &quot;\n• 권장 : &quot;+ sstr(&quot;var container = new cpr.controls.Container();&quot;, [&quot;text-danger&quot;])&#xD;&#xA;+ sstr(&quot;\n• 비권장 : var container = new cpr.controls.Container(\&quot;grpForm\&quot;);&quot;, [&quot;&quot;])">
            <cl:formdata std:sid="f-data-633f45f7" row="1" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-352de19d" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-38d7406e" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:group std:sid="group-118fb0a2" id="grp15">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-ead28b7d" width="1178px" height="305px" autosize="height"/>
        <cl:group std:sid="group-7aa146ab" id="grp16">
          <cl:verticaldata std:sid="v-data-24a4eaf5" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-9d0d5e71" id="udccomformtitle5" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-57bbc23f" row="0" col="0"/>
            <cl:property name="title" value="1-4. 유효성 검증" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-a6ae1fd7" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-1e22b6e6" value="유효성 검증 실패 시, 실패한 요소로 포커스가 설정되어야 합니다.&#xD;&#xA;eXBuilder6에서 제공하는 공통모듈에서 유효성 검증에 대한 기능을 제공하고 있으니, 공통 기능을 사용하시기 바랍니다.">
          <cl:verticaldata std:sid="v-data-02f208a7" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-d37db2f2" id="grp18" class="form-base">
          <cl:verticaldata std:sid="v-data-5c0f7eaa" width="1158px" height="162px" autosize="height"/>
          <cl:udc std:sid="ud-control-0232c2c2" id="udcexamace3" type="udc.exam.udcExamAce">
            <cl:formdata std:sid="f-data-85ec5185" row="0" col="0"/>
            <cl:property name="value" value="function validate() {&#xD;&#xA;&#x9;if (!util.validate(app, &quot;컨트롤ID&quot;)) return false;&#xD;&#xA;&#x9;// … (이하 생략) …&#xD;&#xA;}" type="string"/>
          </cl:udc>
          <cl:output std:sid="output-7a598ffa" class="label" value="스크립트 예시">
            <cl:formdata std:sid="f-data-1617338e" row="0" col="1"/>
          </cl:output>
          <cl:output std:sid="output-0385ff8f" value="공통에서 제공하는 유효성 검사(util.validate)는 유효성 검증을 수행하고, 검증에 실패한 컨트롤으로 포커스 처리가 자동으로 설정됩니다.">
            <cl:formdata std:sid="f-data-cc7c088e" row="0" col="2"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-366c03be" scrollable="false" hspace="10px" vspace="10px" top-margin="5px" right-margin="5px" bottom-margin="5px" left-margin="5px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
            <cl:rows length="1" unit="FRACTION" autoSizing="true"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="140" unit="PIXEL" autoSizing="true" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-7b35c91f" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:group std:sid="group-ab1f408a" id="grp17">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-36c69d30" width="1178px" height="133px" autosize="height"/>
        <cl:group std:sid="group-8e568abe" id="grp19">
          <cl:verticaldata std:sid="v-data-262fe573" width="1198px" height="24px" autosize="height"/>
          <cl:udc std:sid="ud-control-422d0fd9" id="udccomformtitle6" type="udc.com.udcComFormTitle">
            <cl:formdata std:sid="f-data-e218860a" row="0" col="0"/>
            <cl:property name="title" value="1-5. 외부 라이브러리" type="string"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-c966df8a" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:output std:sid="output-c73801e4" value="쉘 컨트롤을 통해 외부 라이브러리를 연동하는 경우, 다음 사항을 반드시 확인 하시기 바랍니다.&#xD;&#xA;&#xD;&#xA;1) tab 키를 통해 쉘 내부 요소와 초점 이동이 가능하지 여부&#xD;&#xA;2) 차트와 같이 시각적인 요소가 포함되어 있을 경우, 요소 간 구분은 색상이 아닌 패턴으로 제공">
          <cl:verticaldata std:sid="v-data-eec823a2" width="1178px" height="79px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-9e11f9f5" spacing="10" leftmargin="10" rightmargin="10" topmargin="10" bottommargin="10"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-787a4b5d" spacing="10" leftmargin="20" rightmargin="20" topmargin="20" bottommargin="20"/>
    </cl:group>
    <cl:group std:sid="group-67720be3" id="grp20" class="border rounded">
      <cl:verticaldata std:sid="v-data-75411e9d" width="1220px" height="2411px" autosize="height"/>
      <cl:udc std:sid="ud-control-1dfb76f4" id="sectiontitle2" type="udc.pb.SectionTitle">
        <cl:verticaldata std:sid="v-data-fbe04d80" width="1180px" height="29px" autosize="none"/>
        <cl:property name="title" value="2. 컨트롤" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-c11030f3" value="각 컨트롤 별 웹 접근성에 관련하여 확인이 필요한 속성에 대하여 설명합니다.&#xD;&#xA;모든 속성은 Properties뷰에서 확인합니다.">
        <cl:verticaldata std:sid="v-data-1f3222c3" width="1158px" height="79px" autosize="height"/>
      </cl:output>
      <cl:group std:sid="group-268deea5" id="grp23">
        <std:metadata>
          <std:property key="template-uuid" value="0abf0c6a-96ee-4fb4-8758-176eeb9b7819"/>
