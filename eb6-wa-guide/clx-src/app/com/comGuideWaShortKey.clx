            <cl:formdata std:sid="f-data-33c3c53b" row="5" col="1"/>
          </cl:output>
          <cl:output std:sid="output-b697d1f0" class="label" value="Ctrl + Alt + U">
            <cl:formdata std:sid="f-data-83a64f8d" row="6" col="0" ignore-layout-spacing="true"/>
