      <cl:group comment="그리드" std:sid="group-85ab48f8" id="grp4" class="content">
        <cl:verticaldata std:sid="v-data-1a7e9b10" width="740px" height="984px" autosize="height"/>
        <cl:group std:sid="group-243f9abe" id="grp6">
          <cl:verticaldata std:sid="v-data-cd7f7b14" width="740px" height="94px" autosize="height"/>
          <cl:output std:sid="output-34bedbc3" class="tit h3" value="그리드" outputtype="h3">
            <cl:verticaldata std:sid="v-data-b74db4e1" width="300px" height="36px" autosize="height"/>
          </cl:output>
          <cl:output std:sid="output-f289eedd" value="" displayexp="&quot;본 화면에서는 테이블을 사용하지 않고, 테이블과 동일한 형태인 그리드를 사용합니다.\n&quot;&#xD;&#xA;+ &quot;사용 방법은 테이블과 유사하지만 일부 다른 동작을 수행하는 단축키를 제공합니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+ sstr(&quot;(1) 스크린리더 - 가상커서 사용 여부\n&quot;, [&quot;text-danger&quot;])&#xD;&#xA;+ &quot;스크린리더를 사용하는 경우 그리드는 &quot;+sstr(&quot;가상커서를 해제&quot;, [&quot;text-primary&quot;])+&quot;하고 사용하는 것을 권장합니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+ sstr(&quot;(2) 스크린리더 내용\n&quot;, [&quot;text-danger&quot;])&#xD;&#xA;+&quot;그리드 최초 진입 시 : &quot; + sstr(&quot;그리드 시작\n&quot;, [&quot;text-primary&quot;])&#xD;&#xA;+&quot;그리드 탐색 종료 시 : &quot; + sstr(&quot;그리드 종료\n\n&quot;, [&quot;text-primary&quot;])&#xD;&#xA;&#xD;&#xA;+ sstr(&quot;(3) 그리드 모드\n&quot;, [&quot;text-danger&quot;])&#xD;&#xA;+&quot;• 읽기모드 : 방향키로 이동하며 커서가 위치하는 셀의 정보만 알 수 있습니다.\n&quot;&#xD;&#xA;+&quot;• 편집모드 : Tab 키로 이동하며 커서가 위치하는 셀에서 값을 수정 할 수 있습니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+&quot;그리드에서 사용 가능한 단축키는 다음을 확인해주세요.&quot;">
            <cl:verticaldata std:sid="v-data-ac1fab42" width="1068px" height="42px" autosize="height"/>
          </cl:output>
          <cl:verticallayout std:sid="v-layout-5c9c31cf"/>
        </cl:group>
        <cl:group std:sid="group-8a755af8" id="grp5" class="form-base">
          <cl:verticaldata std:sid="v-data-0228ab68" width="740px" height="874px" autosize="height"/>
          <cl:output std:sid="output-e902ca74" class="label text-center" value="단축키">
            <cl:formdata std:sid="f-data-5dd62624" row="0" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:output std:sid="output-9912d10b" class="label text-center" value="설명">
            <cl:formdata std:sid="f-data-7cc07f60" row="0" col="1" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:output std:sid="output-bc35cd87" class="label" value="Enter">
            <cl:formdata std:sid="f-data-924462ae" row="1" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:output std:sid="output-f5965421" displayexp="&quot;그리드 모드 전환\n&quot;&#xD;&#xA;+ sstr(&quot;※ 편집모드에서 읽기모드로 전환 시, 수정된 값은 저장됩니다.&quot;, [&quot;text-danger&quot;])">
            <cl:formdata std:sid="f-data-a5a29992" row="1" col="1"/>
          </cl:output>
          <cl:output std:sid="output-7b224380" class="label" value="Tab">
            <cl:formdata std:sid="f-data-84293bce" row="2" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:output std:sid="output-a9849f42" value="▹ 읽기모드 : 그리드 밖 다음 영역으로 포커스 이동&#xD;&#xA;▹ 편집모드 : 그리드 내 기능이 동작하는 요소로 포커스 이동">
            <cl:formdata std:sid="f-data-a8eaf818" row="2" col="1"/>
          </cl:output>
          <cl:output std:sid="output-7c6bb9a9" class="label" value="Shift + Tab">
            <cl:formdata std:sid="f-data-514094ad" row="3" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:output std:sid="output-b192cfdc" value="▹ 읽기모드 : 그리드 밖 이전 영역으로 포커스 이동&#xD;&#xA;▹ 편집모드 : 그리드 내 기능이 동작하는 요소로 포커스 이동">
            <cl:formdata std:sid="f-data-73ff02f8" row="3" col="1"/>
          </cl:output>
          <cl:output std:sid="output-87b4d2df" class="label" value="ESC">
            <cl:formdata std:sid="f-data-ce8e836c" row="4" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:output std:sid="output-fe3585ec" displayexp="&quot;읽기모드로 전환\n&quot;&#xD;&#xA;+ sstr(&quot;※ 편집모드에서 읽기모드로 전환 시, 수정된 값은 저장되지 않습니다.&quot;, [&quot;text-danger&quot;])">
            <cl:formdata std:sid="f-data-b73b3f5a" row="4" col="1"/>
          </cl:output>
          <cl:output std:sid="output-23111070" class="label" value="Space">
