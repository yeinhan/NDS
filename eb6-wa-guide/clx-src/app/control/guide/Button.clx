        <cl:group std:sid="group-5a5c804d" id="grp9" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-31d14edb" width="1544px" height="643px" autosize="height"/>
          <cl:output std:sid="output-515b5048" class="pb-label" value="1. 텍스트가 없는 아이콘으로만 이루어진 버튼에는 tooltip으로 대체 텍스트를 제공해주어야 합니다.">
            <cl:formdata std:sid="f-data-0f91dec3" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-3f7ee269" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-2bdbbd0f" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-14001a00" value="tooltip" unselectable="false">
            <cl:formdata std:sid="f-data-88c7b83e" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-7ca7bbf8" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-a78d26a2" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d2efafaf" value="1.0.3462" unselectable="false">
            <cl:formdata std:sid="f-data-6486d582" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-e42af93e" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-11dc735b" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d10e2d19" value="항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-3f519b02" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-5de7232f" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-58acceb5" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d790bff9" value="전체" unselectable="false">
            <cl:formdata std:sid="f-data-d4af1d63" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-5dc6d411" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-6de7a9ae" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-ed24e748" value="텍스트없이 아이콘으로만 제공된 버튼의 경우, tooltip 속성에 대체 텍스트를 제공해주어야 합니다." displayexp="text + sstr(&quot;\n ※tooltip을 우선적으로 제공해야하며, fieldLabel은 선택사항입니다.&quot;, [&quot;text-red&quot;])" unselectable="false">
            <cl:formdata std:sid="f-data-88682973" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-14d2525e" class="pb-label" value="버튼 속성 지정">
            <cl:formdata std:sid="f-data-7f5485df" row="6" col="0"/>
