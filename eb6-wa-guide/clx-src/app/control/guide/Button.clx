        </cl:udc>
        <cl:group std:sid="group-5cf33ed3" id="grp5" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-e9fd53cf" width="1544px" height="663px" autosize="height"/>
          <cl:output std:sid="output-34010533" class="pb-label" value="2. 링크를 표시해야 할 때 ariaButtonType=link 로 설정한다.">
            <cl:formdata std:sid="f-data-03d06d0a" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-0c5d6d27" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-be9b8d94" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-f32ef496" value="ariaButtonType" unselectable="false">
            <cl:formdata std:sid="f-data-cd85b332" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-adc3e910" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-ba06a516" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-ef2af6b4" value="1.0.3462" unselectable="false">
            <cl:formdata std:sid="f-data-367072e4" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-dca6982d" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-56a6db13" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-4591fd98" value="항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-52140ecd" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-7d54a951" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-b9cfd9bd" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-1d59ecfe" value="시각 장애 (전맹)&#xD;&#xA;사용 환경으로 인해 시각 기능 일시적 사용 불능 및 저하 (운전중, 조명 등)" unselectable="false">
            <cl:formdata std:sid="f-data-9ab8de69" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-6f416e51" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-8505ec06" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-dba13a4d" value="버튼의 용도에 맞게 &quot;link&quot; 또는 &quot;button&quot;으로 설정해야합니다.&#xD;&#xA;ariaButtonType 속성은 &lt;a> 태그의 &quot;role&quot; 속성으로 설정됩니다. (button, link)&#xD;&#xA;&#xD;&#xA;ariaButtonType=button 으로 할 경우 role=&quot;button&quot; 으로 설정됩니다.&#xD;&#xA;스크린리더는 &quot;[버튼 텍스트] + 버튼&quot; 으로 읽습니다.&#xD;&#xA;&#xD;&#xA;ariaButtonType=link 로 설정 할 경우, role=&quot;link&quot;로 설정됩니다. &#xD;&#xA;스크린리더는 &quot;[버튼 텍스트] + 링크&quot; 로 읽습니다." unselectable="false">
            <cl:formdata std:sid="f-data-047880ee" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-ddec7f1e" class="pb-label" value="버튼 속성 지정">
            <cl:formdata std:sid="f-data-86c8e51e" row="6" col="0"/>
          </cl:output>
