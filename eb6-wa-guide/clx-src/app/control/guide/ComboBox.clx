            <cl:formdata std:sid="f-data-5170d53c" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d30cf35f" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ae3a19e0" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-90bf151d" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-bf4d6266" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-b50def24" value="시각 장애&#xD;" unselectable="false">
            <cl:formdata std:sid="f-data-e43a9b8b" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-16382fbb" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-614165d4" row="5" col="0"/>
          </cl:output>
          <cl:group std:sid="group-c1edec01" id="grp8">
            <cl:formdata std:sid="f-data-9fbbcf6a" row="5" col="1" rowspan="1" colspan="3"/>
            <cl:output std:sid="output-ab56ca87" value="콤보박스가 포커스 되있을 때, 아래 방향키를 눌러 리스트 팝업을 띄울 수 있습니다.&#xD;&#xA;해당 동작은 콤보박스의 keydown 이벤트를 통해 작성 할 수 있으며, 아래 스크립트를 사용합니다.&#xD;&#xA;" unselectable="false">
              <cl:formdata std:sid="f-data-cc8a39c3" row="0" col="0" rowspan="1" colspan="3"/>
            </cl:output>
            <cl:udc std:sid="ud-control-ad921027" id="udcexamace1" style="padding-top:0px; padding-left:10px; padding-bottom:10px; padding-right:10px;" type="udc.exam.udcExamAce">
              <cl:formdata std:sid="f-data-69c63ada" row="1" col="0" rowspan="1" colspan="3"/>
              <cl:property name="value" value="function cmbKeydownFunc(e) {&#xD;&#xA;&#x9; /** @type cpr.controls.ComboBox*/&#xD;&#xA;&#x9; var cmb1 = e.control;&#xD;&#xA;&#x9; if (cpr.events.KeyCode.UP == e.keyCode || cpr.events.KeyCode.DOWN == e.keyCode) {&#xD;&#xA;&#x9;&#x9; if (!cmb1.isOpened()) {&#xD;&#xA;&#x9;&#x9;&#x9; cpr.core.DeferredUpdateManager.INSTANCE.asyncExec(function() {&#xD;&#xA;&#x9;&#x9;&#x9; &#x9;cmb1.open();&#xD;&#xA;&#x9;&#x9;&#x9; });&#xD;&#xA;&#x9;&#x9;&#x9; e.preventDefault(); // 방향키로 값 변경되는 동작 방지&#xD;&#xA;&#x9;&#x9; }&#xD;&#xA;&#x9; }&#xD;&#xA;}" type="string"/>
              <cl:property name="language" value="javascript" type="enumeration"/>
            </cl:udc>
            <cl:formlayout std:sid="f-layout-26d70929" scrollable="false" hspace="8px" vspace="5px" hseparatorwidth="1" vseparatorwidth="1">
              <cl:rows length="28" unit="PIXEL" autoSizing="true" hidden="false" shadecolor="#000000" minlength="0"/>
              <cl:rows length="80" unit="PIXEL" autoSizing="true" hidden="false" shadecolor="#000000" minlength="0"/>
              <cl:columns length="1" unit="FRACTION"/>
              <cl:columns length="150" unit="PIXEL" shadecolor="transparent"/>
              <cl:columns length="1" unit="FRACTION"/>
            </cl:formlayout>
          </cl:group>
