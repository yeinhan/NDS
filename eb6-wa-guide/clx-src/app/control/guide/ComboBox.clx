        <cl:group std:sid="group-bedd990d" id="grp13" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-2e6e8d4c" width="1544px" height="619px" autosize="height"/>
          <cl:output std:sid="output-320c8d70" class="pb-label" value="2. preventInput = true 설정한 경우 방향키 상/하 기본동작을 방지하고 리스트 팝업하여 선택하도록 변경한다.">
            <cl:formdata std:sid="f-data-f4fce933" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-fe39a97e" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-a5011ccb" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-6bac81bf" value="preventInput" unselectable="false">
