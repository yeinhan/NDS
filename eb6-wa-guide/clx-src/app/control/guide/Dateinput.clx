          </cl:output>
          <cl:output std:sid="output-de2931ad" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-bd73903a" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-5426b3d1" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.&#xD;&#xA;항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-6eed4777" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-92ed81ad" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-68e69d5b" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-b1e23506" value="지체 장애, 고령자&#xD;" unselectable="false">
            <cl:formdata std:sid="f-data-785d3a39" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-9248ffa5" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-17511551" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-90311e3e" value="데이트 인풋에서 탭 키를 눌러 clear 버튼과 캘린더 버튼으로 초점을 이동 할 수 있습니다.&#xD;&#xA;포커스된 버튼들은 모두 space 키 또는 enter 키를 눌러 동작합니다.&#xD;" unselectable="false">
            <cl:formdata std:sid="f-data-97c147e8" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
