          </cl:output>
          <cl:output std:sid="output-e1490043" value="데이트 인풋에 대응하는 레이블을 aria-label 에 제공합니다.&#xD;&#xA;&#xD;&#xA;※ 필수입력 항목인 경우 fieldLabel에 &quot;필수입력&quot;을 함께 입력해야합니다. &#xD;&#xA;" displayexp="text+sstr(&quot;ex) fieldLabel = '등록일자 필수입력'&quot;, [&quot;text-primary&quot;])" unselectable="false">
            <cl:formdata std:sid="f-data-660670a8" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
