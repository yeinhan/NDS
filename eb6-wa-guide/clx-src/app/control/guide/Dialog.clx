        <cl:verticaldata std:sid="v-data-3ed7c833" width="1544px" height="554px" autosize="height"/>
        <cl:udc std:sid="ud-control-392b571a" type="udc.pb.SectionTitle">
          <cl:verticaldata std:sid="v-data-4508bfac" width="1544px" height="29px"/>
          <cl:property name="title" value="다이얼로그 – 다이얼로그를 열 때 초점 이동" type="string"/>
        </cl:udc>
        <cl:group std:sid="group-bedd990d" id="grp3" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-2e6e8d4c" width="1544px" height="511px" autosize="height"/>
          <cl:output std:sid="output-320c8d70" class="pb-label" value="1. 다이얼로그를 열 때 초점이 다이얼로그로 이동해야 한다.">
            <cl:formdata std:sid="f-data-f4fce933" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-fe39a97e" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-a5011ccb" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-6bac81bf" value="autoFocusedTarget" unselectable="false">
            <cl:formdata std:sid="f-data-705476ed" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-6834a164" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-4098967f" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-05f938b4" value="1.0.3905" unselectable="false">
            <cl:formdata std:sid="f-data-10f77d72" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-667fd02b" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-5170d53c" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d30cf35f" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.&#xD;&#xA;항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ae3a19e0" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-90bf151d" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-bf4d6266" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-b50def24" value="시각 장애&#xD;" unselectable="false">
            <cl:formdata std:sid="f-data-e43a9b8b" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-16382fbb" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-614165d4" row="5" col="0"/>
          </cl:output>
          <cl:group std:sid="group-e13c4fb3" id="grp15">
            <cl:formdata std:sid="f-data-aee64aca" row="5" col="1" rowspan="1" colspan="3"/>
            <cl:output std:sid="output-ab56ca87" value="- 다이얼로그가 열리면 초점이 다이얼로그로 이동하여, 탭 키를 눌렀을 때 다이얼로그 내부에서 초점이 이동 될 수 있도록 해야 합니다." unselectable="false">
              <cl:formdata std:sid="f-data-cc8a39c3" row="0" col="0" rowspan="1" colspan="3"/>
            </cl:output>
            <cl:output std:sid="output-c1be1d40" value="- openDialog() API로 Dialog를 열 때 autoFocusedTarget 속성으로 포커스 진입지점을 설정합니다.&#xD;&#xA;&#xD;&#xA;" displayexp="text&#xD;&#xA;+ &quot;- &quot;+sstr(&quot;autoFocusedTarget = ['auto', 'none', 'self', 'firstChild'] \n &quot;, [&quot;fw-bold&quot;])&#xD;&#xA;+ &quot;- &quot;+sstr(&quot;auto(기본값)&quot;, [&quot;text-primary&quot;])+&quot; : 헤더가 있는 경우 다이얼로그에 포커스가 설정됩니다. 헤더가 없는 경우 열리는 앱의 첫번째 컨트롤에 포커스를 설정합니다. \n &quot;&#xD;&#xA;+ &quot;- &quot;+sstr(&quot;none&quot;, [&quot;text-primary&quot;])+&quot; : 포커스를 설정하지 않습니다. \n  &quot;&#xD;&#xA;+ &quot;- &quot;+sstr(&quot;self&quot;, [&quot;text-primary&quot;])+&quot; : 다이얼로그에 포커스를 설정합니다. \n &quot;&#xD;&#xA;+ &quot;- &quot;+sstr(&quot;firstChild&quot;, [&quot;text-primary&quot;])+&quot; : 포커스 가능한 첫번째 요소에 포커스를 설정합니다. 헤더가 있는 경우 헤더의 버튼이 첫번째 포커스 요소가 됩니다.&quot;">
              <cl:formdata std:sid="f-data-62d06653" row="1" col="0" rowspan="1" colspan="3"/>
            </cl:output>
            <cl:udc std:sid="ud-control-ad921027" id="udcexamace1" style="padding-top:0px; padding-left:10px; padding-bottom:10px; padding-right:10px;" type="udc.exam.udcExamAce">
              <cl:formdata std:sid="f-data-67de9110" row="2" col="0" rowspan="1" colspan="3"/>
              <cl:property name="value" value="// openDialog() 시 autoFocusedTarget 속성 설정 예시&#xD;&#xA;function onButtonClick(e){&#xD;&#xA;&#x9;app.openDialog(appId, {width: 800, height: 580, autoFocusedTarget:&quot;auto&quot;});&#xD;&#xA;}" type="string"/>
              <cl:property name="language" value="javascript" type="enumeration"/>
            </cl:udc>
