          </cl:output>
          <cl:output std:sid="output-dac4e599" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-f776ff11" row="5" col="0"/>
          </cl:output>
          <cl:group std:sid="group-278a68ba" id="grp17">
            <cl:formdata std:sid="f-data-aa5c6c0d" row="5" col="1" rowspan="1" colspan="3"/>
            <cl:output std:sid="output-b8c69587" value="- Dialog가 닫히면 Dialog를 열기 전 위치로 초점이 돌아가고 이후 초점이 논리적으로 이동되어야 합니다." unselectable="false">
              <cl:formdata std:sid="f-data-92e63c5b" row="0" col="0" rowspan="1" colspan="3"/>
            </cl:output>
            <cl:output std:sid="output-5f4f3f60" value="- openDialog()로 Dialog를 열 때 restoreFocus 속성을 true 로 설정하여 Dialog를 닫을 때 Dialog를 열기 전 위치로 초점이 돌아갈 수 있도록 설정합니다.">
              <cl:formdata std:sid="f-data-435a206a" row="1" col="0" rowspan="1" colspan="3"/>
            </cl:output>
            <cl:udc std:sid="ud-control-30bdf755" id="udcexamace3" style="padding-top:0px; padding-left:10px; padding-bottom:10px; padding-right:10px;" type="udc.exam.udcExamAce">
              <cl:formdata std:sid="f-data-4ae1d36d" row="2" col="0" rowspan="1" colspan="3"/>
              <cl:property name="value" value="// openDialog() 시 restoreFocus 속성 설정&#xD;&#xA;function onButtonClick(e){&#xD;&#xA;&#x9;app.openDialog(appId, {width: 800, height: 580, restoreFocus: true});&#xD;&#xA;}" type="string"/>
              <cl:property name="language" value="javascript" type="enumeration"/>
            </cl:udc>
