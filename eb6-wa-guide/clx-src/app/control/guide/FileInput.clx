          </cl:output>
          <cl:output std:sid="output-e3492ef8" value="시각 장애 (전맹)&#xD;&#xA;사용 환경으로 인해 시각 기능 일시적 사용 불능 및 저하 (운전중, 조명등)" unselectable="false">
            <cl:formdata std:sid="f-data-604788bd" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-866771de" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-e9876e80" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-e1490043" value="파일인풋 컨트롤에서 파일 선택여부에 따라 aria-label 을 다르게 제공하여 동작방법 및 선택여부를알 수 있도록 제공해야 합니다.&#xD;&#xA;&#xD;&#xA;" displayexp="text+sstr(&quot;ex) fileInput.bind('fieldLabel').toExpression('value? '사진선택, '+value+' 사진파일이 선택되었습니다.' : '사진선택, 클릭하거나 사진파일을 드래그 하세요.'');&quot;, [&quot;text-primary&quot;])" unselectable="false">
            <cl:formdata std:sid="f-data-660670a8" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
