          <cl:verticaldata std:sid="v-data-f0fc043e" width="1544px" height="29px"/>
          <cl:property name="title" value="그룹핑 그리드" type="string"/>
        </cl:udc>
        <cl:group std:sid="group-536ca4c0" id="grp24" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-94bbf11c" width="1180px" height="909px" autosize="height"/>
          <cl:output std:sid="output-0d62e0a0" class="pb-label" value="6. 그룹핑 그리드는 트리셀 컨트롤을 통해 구성한다.">
            <cl:formdata std:sid="f-data-09181099" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-dcc1368b" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-30eaad4b" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-42cf5533" value="-" unselectable="false">
            <cl:formdata std:sid="f-data-e53d6000" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-36463b2d" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-66da9ad5" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-ac9d1cd9" value="-" unselectable="false">
            <cl:formdata std:sid="f-data-3c1a734b" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-e1ca9d64" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-e952776c" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-a95b6a5b" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-fd738d4a" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-30c79b67" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-15d16150" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-ae907428" value="지체 장애, 고령자" unselectable="false">
            <cl:formdata std:sid="f-data-d86a0f41" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-60c35c4d" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-0cf04ae0" row="5" col="0"/>
          </cl:output>
          <cl:group std:sid="group-1c7ea257" id="grp25">
            <cl:formdata std:sid="f-data-7178a892" width="100" height="69" row="5" col="1" rowspan="1" colspan="3"/>
            <cl:output std:sid="output-3c7cf7ae" value="웹 접근성 준수를 위해 그룹핑 그리드 사용 시, 트리셀 컨트롤을 배치하여 그룹핑 그리드를 구성합니다.&#xD;&#xA;또한 Enter 또는 Space 키를 통해 그룹을 접고 펼칠 수 있도록 스크립트 작성이 필요합니다.&#xD;&#xA;스크립트는 그리드의 cell-click 이벤트와 keydown 이벤트가 필요하며, 아래와 같이 작성해주시기 바랍니다." unselectable="false">
              <cl:formdata std:sid="f-data-242e9374" row="0" col="0" rowspan="1" colspan="3"/>
            </cl:output>
            <cl:udc std:sid="ud-control-3f0018ec" id="udcexamace2" style="padding-top:0px; padding-left:10px; padding-bottom:10px; padding-right:10px;" type="udc.exam.udcExamAce">
              <cl:formdata std:sid="f-data-6cd64dbc" row="2" col="0" rowspan="1" colspan="3"/>
              <cl:property name="value" value="/*&#xD;&#xA; * 그리드에서 cell-click 이벤트 발생 시 호출.&#xD;&#xA; * Grid의 Cell 클릭시 발생하는 이벤트.&#xD;&#xA; */&#xD;&#xA;function onGridCellClick(e){&#xD;&#xA;&#x9;var grid = e.control;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;// 마우스로 모든 셀 클릭시 그룹 행 접고/펼치기&#xD;&#xA;&#x9;var voTargetObject = e.targetObject;&#xD;&#xA;&#x9;var voRowGroup = grid.getGridRowGroup(voTargetObject.rowIndex);&#xD;&#xA;&#x9;if(voRowGroup) voRowGroup.expanded = !voRowGroup.expanded;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/*&#xD;&#xA; * 그리드에서 keydown 이벤트 발생 시 호출.&#xD;&#xA; * 사용자가 키를 누를 때 발생하는 이벤트. 키코드 관련 상수는 {@link cpr.events.KeyCode}에서 참조할 수 있습니다.&#xD;&#xA; */&#xD;&#xA;function onGridKeydown(e){&#xD;&#xA;&#x9;var grid = e.control;&#xD;&#xA;&#x9;// Enter 키 누를때마다 그룹행 접고/펼치기&#xD;&#xA;&#x9;var voTargetObject = e.targetObject;&#xD;&#xA;&#x9;if (e.keyCode == cpr.events.KeyCode.ENTER) {&#xD;&#xA;&#x9;&#x9;var voRowGroup = grid.getGridRowGroup(voTargetObject.rowIndex);&#xD;&#xA;&#x9;&#x9;if(voRowGroup) voRowGroup.expanded = !voRowGroup.expanded;&#xD;&#xA;&#x9;}&#xD;&#xA;}" type="string"/>
            </cl:udc>
            <cl:group std:sid="group-64676c89" id="grp28">
              <cl:formdata std:sid="f-data-b2505293" row="1" col="0" rowspan="1" colspan="3"/>
              <cl:group std:sid="group-b29fc4bc" id="grp33" class="cl-form-group">
                <cl:formdata std:sid="f-data-7c11056f" row="1" col="1"/>
                <cl:tabfolder std:sid="t-folder-a5714004" id="tab2">
                  <cl:formdata std:sid="f-data-006be5d4" row="1" col="0"/>
                  <cl:tabitem std:sid="t-item-03f4efb8" selected="true" text="일반">
                    <std:metadata>
                      <std:property key="is-active-item" value="true"/>
                    </std:metadata>
                    <cl:group std:sid="group-431061e5" id="grp30">
                      <std:metadata>
                        <std:property key="locked" value="true"/>
                      </std:metadata>
                      <cl:group std:sid="group-13bf3fac" id="grp32" class="cl-form-group">
                        <cl:verticaldata std:sid="v-data-8c3af5a4" width="1010px" height="32px" autosize="none"/>
                        <cl:output std:sid="output-4535cc51" class="label" value="level">
                          <cl:formdata std:sid="f-data-84fc0fb2" row="0" col="0"/>
                        </cl:output>
                        <cl:output std:sid="output-d92fe06a" tooltip="상대컬럼 바인딩" value="rel://level">
                          <cl:formdata std:sid="f-data-c7452d7d" row="0" col="1"/>
                        </cl:output>
                        <cl:formlayout std:sid="f-layout-0e84f85d" scrollable="false" hspace="8px" vspace="4px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px" hseparatorwidth="1" hseparatortype="BY_CLASS" vseparatorwidth="1" vseparatortype="BY_CLASS">
                          <cl:rows length="30" unit="PIXEL"/>
                          <cl:columns length="140" unit="PIXEL"/>
                          <cl:columns length="1" unit="FRACTION"/>
                        </cl:formlayout>
                      </cl:group>
                      <cl:verticallayout std:sid="v-layout-b88d4046"/>
