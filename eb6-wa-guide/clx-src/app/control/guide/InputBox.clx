            <cl:formdata std:sid="f-data-2f6236d2" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-918153ad" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.&#xD;&#xA;항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-31415ff3" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-d69349c0" class="pb-label" value="적용 대상">
