            <cl:formdata std:sid="f-data-19fdb89f" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-59d9cd45" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-6dc14c77" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-5c5c69cc" value="showClearButton=true 일 경우, 탭 키를 통해 clear 버튼으로 포커스를 이동 할 수 있습니다.&#xD;&#xA;초점이 clear 버튼에 있을 때, space 키 또는 enter 키를 눌러 값을 초기화 할 수 있습니다" unselectable="false">
            <cl:formdata std:sid="f-data-06c06eda" row="5" col="1" rowspan="1" colspan="3"/>
