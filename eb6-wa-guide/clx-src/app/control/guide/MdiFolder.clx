          <cl:output std:sid="output-d581e4a9" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-eb7d9d55" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-066012aa" value="해당 속성을  false 로 설정 시, 탭 헤더 아이템에서 좌/우 방향키로 포커스 이동 시, Enter 키를 눌러 선택하고자 하는 탭 아이템을 직접 선택합니다.&#xD;&#xA;이때 Space 키는 기존과는 다르게 체크박스 선택/해제 시에만 동작합니다." unselectable="false">
            <cl:formdata std:sid="f-data-49ff4a2c" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
