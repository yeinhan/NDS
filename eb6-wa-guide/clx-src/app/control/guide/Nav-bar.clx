            <cl:formdata std:sid="f-data-e1244f20" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-e4c36fee" value="항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다" unselectable="false">
            <cl:formdata std:sid="f-data-a2744802" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-84cc75e7" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-81e8de67" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-0d61c8bf" value="시각 장애, 저시력자, 지체 장애, 고령자" unselectable="false">
            <cl:formdata std:sid="f-data-c8657fe2" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-ab6759ef" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-86b98605" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-f4a862e9" value="GNB 영역의 사이트맵 성격을 가진 메뉴로 사용 할 경우, 모든 메뉴는 TAB 키를 통해 이동이 가능해야 합니다.&#xD;&#xA;tabTraversal=true 로 설정하게 될 경우, 내비게이션 바의 모든 메뉴를 TAB 키를 통해 이동 할 수 있습니다." unselectable="false">
            <cl:formdata std:sid="f-data-07641468" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
