          <cl:output std:sid="output-f8079e3a" value="1.0.4427" unselectable="false">
            <cl:formdata std:sid="f-data-88572d07" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-1a5d81cb" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-7c63c4e8" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-228a46d4" value="항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ab24d35e" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-7681468e" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-ce8b4a86" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-e3480195" value="시각 장애, 저시력자" unselectable="false">
            <cl:formdata std:sid="f-data-e90f8f40" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-4e2f818b" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-820d33f8" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-3e79b9d6" displayexp="&quot;menuType=accessiblemegamenu 형태의 내비게이션바에서는 각 아이템 간 종속관계를 알 수 있도록 제공합니다.\n&quot;&#xD;&#xA;+&quot;단, 현재 아이템의 depth 를 좀 더 쉽게 파악하기 위해 displayExp 를 통해  추가적인 정보를 제공합니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+&quot;displayExp 속성에 텍스트와 더불어 depth 정보를 함께 작성하며, depth 정보는 시각적으로 보이지 않고, 스크린리더를 통해서만 확인이 가능합니다. (cl-sound-only 클래스)\n&quot;&#xD;&#xA;+sstr(&quot;ex) label + sstr(depth + '단계', ['cl-sound-only'])\n\n&quot;, [&quot;text-primary&quot;])&#xD;&#xA;&#xD;&#xA;+&quot;추가적으로 아이템 클릭 시 새 창이 열릴 경우에는 조건을 덧붙혀 새 창 열기 여부를 함께 제공해야 합니다.\n&quot;&#xD;&#xA;+&quot;displayExp 속성에 메뉴의 depth과 새창열기 여부를 확인하는 낭독 전용 텍스트를 추가해줍니다. (cl-sound-only 클래스)\n&quot;&#xD;&#xA;+ sstr(&quot;ex) label + sstr(depth + '단계' + ((CALL_PAGE !='' &amp;&amp; CALL_PAGE.indexOf('.clx') == -1) ? ' 새창 열기' : ''), ['cl-sound-only'])&quot;, [&quot;text-primary&quot;])" unselectable="false">
            <cl:formdata std:sid="f-data-7cb07972" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-7221ad45" class="pb-label" value="내비게이션바 속성 지정">
            <cl:formdata std:sid="f-data-6ececf02" row="6" col="0"/>
          </cl:output>
