            <cl:formdata std:sid="f-data-5170d53c" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d30cf35f" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ae3a19e0" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-90bf151d" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-bf4d6266" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-b50def24" value="전체" unselectable="false">
            <cl:formdata std:sid="f-data-e43a9b8b" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-16382fbb" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-614165d4" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-ab56ca87" value="" displayexp="&quot;웹 접근성을 준수하는 페이지의 경우 다음과 같이 알림 컨트롤을 사용해야 합니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA;+ sstr(&quot;&lt; 알림 컨트롤 – Help Contents 참조 >\n&quot;, [&quot;fw-bold&quot;])&#xD;&#xA;+&quot;1. 자동으로 닫히면 안됩니다.&quot;+ sstr( &quot; (delay 속성을 Int 형식 변수의 최댓값인 2,147,483,647 로 설정해야 합니다.)\n&quot;, [&quot;text-info&quot;])&#xD;&#xA;+&quot;2. '닫기'버튼을 제공해야 합니다.&quot;+sstr(&quot; (close 속성을 true 로 설정해야 합니다.)\n&quot;, [&quot;text-info&quot;])&#xD;&#xA;+&quot;3. 알림 컨트롤을 키보드로 접근, 복귀가 가능해야 합니다.\n\n&quot;&#xD;&#xA;&#xD;&#xA; +&quot;알림 컨트롤이 띄워진 경우, 현재 포커스 컨트롤에서 &quot;+sstr(&quot;탭 이동시 알림 컨트롤로 포커스 이동&quot;, [&quot;text-underline&quot;])+&quot;해야 하고, 알림 컨트롤의 리스트가 &quot;+sstr(&quot;모두 닫히는 경우 기존 컨트롤로  포커스 이동&quot;, [&quot;text-underline&quot;])+&quot;해야 합니다.\n&quot;&#xD;&#xA;+sstr(&quot;focusItem(item, restoreFocusControl) API&quot;, [&quot;text-info&quot;])+&quot; 를 사용하시기 바랍니다.&quot;" unselectable="false">
            <cl:formdata std:sid="f-data-cc8a39c3" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-71e5dc3b" class="pb-label" value="알림 속성 지정">
            <cl:formdata std:sid="f-data-ba6d82ed" row="6" col="0"/>
          </cl:output>
