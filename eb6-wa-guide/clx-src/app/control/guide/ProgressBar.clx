      </std:metadata>
      <cl:verticaldata std:sid="v-data-6d77e5b7" width="1280px" height="884px" autosize="height"/>
      <cl:group std:sid="group-ad00495f" id="grp2">
        <std:metadata>
          <std:property key="template-uuid" value="f07b9449-b471-4d94-b69e-78b08a168d46"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-3ed7c833" width="1544px" height="784px" autosize="height"/>
        <cl:udc std:sid="ud-control-392b571a" id="sectiontitle1" type="udc.pb.SectionTitle">
          <cl:verticaldata std:sid="v-data-4508bfac" width="1544px" height="29px"/>
          <cl:property name="title" value="프로그레스 – fieldLabel" type="string"/>
        </cl:udc>
        <cl:group std:sid="group-bedd990d" id="grp13" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-2e6e8d4c" width="1544px" height="741px" autosize="height"/>
          <cl:output std:sid="output-320c8d70" class="pb-label" value="1. fieldLabel 속성에 익스프레션 바인딩으로 진행상황을 읽을 수 있도록 설정한다.">
            <cl:formdata std:sid="f-data-f4fce933" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-fe39a97e" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-a5011ccb" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-6bac81bf" value="fieldLabel" unselectable="false">
            <cl:formdata std:sid="f-data-705476ed" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-6834a164" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-4098967f" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-05f938b4" value="-" unselectable="false">
            <cl:formdata std:sid="f-data-10f77d72" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-667fd02b" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-5170d53c" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d30cf35f" value="항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록  대체 텍스트를 제공해야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ae3a19e0" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-90bf151d" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-bf4d6266" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-b50def24" value="시각 장애" unselectable="false">
            <cl:formdata std:sid="f-data-e43a9b8b" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-16382fbb" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-614165d4" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-ab56ca87" value="" displayexp="&quot;프로그레스바는 현재 진행상황에 대해 표시하는 경우를 많이 볼 수 있습니다.\n&quot;&#xD;&#xA;+&quot;이러한 진행상황에 대한 내용을 스크린리더를 통해도 확인이 가능해야 하므로, 프로그레스바의 fieldLabel 을 통해 작성해야 합니다.\n\n&quot;&#xD;&#xA;+sstr(&quot;ex) progress.bind(\&quot;fieldLabel\&quot;).toExpression('진행상황: +self.max+\&quot;% 중 현재 \&quot;+value+\&quot;% 진행 중\&quot;');&quot;, [&quot;text-primary&quot;])" unselectable="false">
            <cl:formdata std:sid="f-data-cc8a39c3" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-2641a5fc" class="pb-label" value="프로그래스바 속성 지정">
            <cl:formdata std:sid="f-data-0edec3d4" row="6" col="0"/>
          </cl:output>
          <cl:group std:sid="group-20aa1b9e" id="grp3">
            <cl:formdata std:sid="f-data-428581dd" row="6" col="1" rowspan="1" colspan="3"/>
            <cl:img std:sid="image-89c67c86" id="img1" src="../웹접근성 캡쳐 이미지/5. 아웃풋 계열/4.1.5.5_프로그레스바-fieldLabel_Properties.png" alt="프로그래스바 속성 지정">
              <cl:flowlayoutdata std:sid="f-data-a701c3a3" width="568px" height="271px"/>
            </cl:img>
            <cl:flowlayout std:sid="f-layout-456f0506" scrollable="false"/>
          </cl:group>
          <cl:output std:sid="output-960fe1ee" class="pb-label" value="DOM 내용 확인">
            <cl:formdata std:sid="f-data-d680777e" row="7" col="0"/>
          </cl:output>
          <cl:group std:sid="group-4a7e0577" id="grp4">
            <cl:formdata std:sid="f-data-46ea6964" row="7" col="1" rowspan="1" colspan="3"/>
            <cl:img std:sid="image-c2a0ad22" id="img2" src="../웹접근성 캡쳐 이미지/5. 아웃풋 계열/4.1.5.5_프로그레스바-fieldLabel_DOM.png" alt="DOM 내용 확인">
              <cl:flowlayoutdata std:sid="f-data-6a9dbc93" width="568px" height="88px"/>
            </cl:img>
