          </cl:group>
          <cl:output std:sid="output-bc3c0650" class="pb-label" value="적용">
            <cl:formdata std:sid="f-data-f8bf149f" row="8" col="0"/>
          </cl:output>
          <cl:group std:sid="group-8dbb6592" id="grp14">
            <cl:formdata std:sid="f-data-9299429a" row="8" col="1"/>
            <cl:progress std:sid="progress-c23c3a3b" id="pgr1" value="50">
              <cl:expbind property="fieldLabel" category="PROPERTY" expression="'진행상황: '+self.max+&quot;% 중 현재&quot;+value+&quot;% 진행 중&quot;"/>
              <cl:formdata std:sid="f-data-713b8d63" row="0" col="0"/>
