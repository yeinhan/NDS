          </cl:output>
          <cl:output std:sid="output-667f8b11" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-fef5ee08" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-da8df821" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.&#xD;&#xA;항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-a9c75c26" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-46224f38" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-dc025fa8" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-7273b0f9" value="지체 장애, 고령자" unselectable="false">
            <cl:formdata std:sid="f-data-7068e098" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-e1e9494d" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-ff9721da" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-063d30eb" value="서치인풋에서 탭 키를 눌러 clear 버튼과 서치 버튼으로 초점을 이동 할 수 있습니다.&#xD;&#xA;포커스된 버튼들은 모두 space 키 또는 enter 키를 눌러 동작합니다.&#xD;" unselectable="false">
            <cl:formdata std:sid="f-data-8ea4a187" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
