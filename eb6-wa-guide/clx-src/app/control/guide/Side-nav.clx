          <cl:output std:sid="output-320c8d70" class="pb-label" value="1. 트리형태의 메뉴일 경우 TAB 키를 통해 이동할 수 있어야 한다.">
            <cl:formdata std:sid="f-data-f4fce933" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-fe39a97e" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-a5011ccb" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-6bac81bf" value=" -" unselectable="false">
            <cl:formdata std:sid="f-data-705476ed" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-6834a164" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-4098967f" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-05f938b4" value="1.0.3545" unselectable="false">
            <cl:formdata std:sid="f-data-10f77d72" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-667fd02b" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-5170d53c" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d30cf35f" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ae3a19e0" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-90bf151d" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-bf4d6266" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-b50def24" value="시각 장애, 지체 장애, 고령자&#xD;" unselectable="false">
            <cl:formdata std:sid="f-data-e43a9b8b" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-16382fbb" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-614165d4" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-ab56ca87" value="사이드 메뉴 형태로 사용되는 메뉴는 TAB 키를 통해 아이템 이동이 가능해야 합니다.&#xD;&#xA;기존의 트리는 방향키로 이동 하는 컨트롤이기 때문에 사이드 내비게이션바 컨트롤을 사용하여 메뉴를 구현합니다. &#xD;&#xA;사이드 내비게이션바의 아이템 이동하기 위한 기본 동작은 TAB 키 입니다." unselectable="false">
            <cl:formdata std:sid="f-data-cc8a39c3" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-bc3c0650" class="pb-label" value="적용&#xD;&#xA;(사이드 내비게이션)">
            <cl:formdata std:sid="f-data-f8bf149f" row="6" col="0"/>
          </cl:output>
