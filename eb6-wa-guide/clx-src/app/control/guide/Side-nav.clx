        <cl:udc std:sid="ud-control-4b483ae7" id="sectiontitle2" type="udc.pb.SectionTitle">
          <cl:verticaldata std:sid="v-data-1712597c" width="1544px" height="29px"/>
          <cl:property name="title" value="사이드 내비게이션 – displayExp" type="string"/>
        </cl:udc>
        <cl:group std:sid="group-4c6475c5" id="grp18" class="pb-table wa-table" clipcontent="false">
          <std:metadata>
            <std:property key="template-uuid" value="12fd52d0-2f82-49b7-b410-9c01fde5e26f"/>
            <std:property key="template-rev" value="2"/>
          </std:metadata>
          <cl:verticaldata std:sid="v-data-96206285" width="1180px" height="827px" autosize="height"/>
          <cl:output std:sid="output-acfd2b5b" class="pb-label" value="2. 아이템 클릭 시 새 창이 열리는 경우, 새창열기 여부를 제공한다.">
            <cl:formdata std:sid="f-data-230d59af" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-3e13d5f3" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-f38e1c20" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-5f232c8d" value="displayExp" unselectable="false">
            <cl:formdata std:sid="f-data-e317c01d" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-f4a6793f" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-22c39f0a" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-f8079e3a" value="1.0.4427" unselectable="false">
            <cl:formdata std:sid="f-data-88572d07" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-1a5d81cb" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-7c63c4e8" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-228a46d4" value="항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ab24d35e" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-7681468e" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-ce8b4a86" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-e3480195" value="시각 장애" unselectable="false">
            <cl:formdata std:sid="f-data-e90f8f40" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-4e2f818b" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-820d33f8" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-3e79b9d6" displayexp="&quot;사이드내비게이션에서는 각 아이템의 종속관계를 알 수 있도록 제공합니다.\n&quot;&#xD;&#xA;+&quot;단, 아이템 클릭 시 새창이 열릴 경우에는 조건을 덧붙혀 새창열기 여부를 함께 제공해야 합니다.\n&quot;&#xD;&#xA;+&quot;새 창 열기 에 대한 정보는 시각적으로 보이지 않고, 스크린리더를 통해서만 확인이 가능합니다. (cl-sound-only 클래스)\n\n&quot;&#xD;&#xA;&#xD;&#xA;+sstr(&quot;ex) label + ((CALL_PAGE !=\&quot;\&quot; &amp;&amp; CALL_PAGE.indexOf(\&quot;.clx\&quot;) == -1) ? sstr(\&quot;새 창 열기\&quot;, [\&quot;cl-sound-only\&quot;]) : \&quot;\&quot;)&quot;, [&quot;text-primary&quot;])" unselectable="false">
            <cl:formdata std:sid="f-data-544baa7c" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-7221ad45" class="pb-label" value="내비게이션바 속성 지정">
            <cl:formdata std:sid="f-data-6ececf02" row="6" col="0"/>
