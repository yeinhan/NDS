          <cl:output std:sid="output-7fb439eb" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-597a62c1" row="5" col="0"/>
          </cl:output>
          <cl:group std:sid="group-276a8b20" id="grp11">
            <cl:formdata std:sid="f-data-9170e1bb" row="5" col="1" rowspan="1" colspan="3"/>
            <cl:output std:sid="output-e081186e" value="하위 아이템이 존재하는 부모 아이템의 경우, 선택하였을 때 확대/축소 할 수 있는 기능을 제공 할 수 있습니다.&#xD;&#xA;부모 아이템에서 스페이스 바 또는 엔터키를 통해 확대/축소 역할을 수행 할 수 있으며, 토글 기능으로 인해 선택을 할 수 없습니다.&#xD;&#xA;해당 기능은 아래 이벤트 (before-selection-change, item-click 이벤트) 를 통해 설정 할 수 있습니다.&#xD;&#xA;" unselectable="false">
              <cl:formdata std:sid="f-data-0bc3dd4b" row="0" col="0" rowspan="1" colspan="3"/>
            </cl:output>
            <cl:udc std:sid="ud-control-ad921027" id="udcexamace1" style="padding-top:0px; padding-left:10px; padding-bottom:10px; padding-right:10px;" type="udc.exam.udcExamAce">
              <cl:formdata std:sid="f-data-25bf1276" row="1" col="0" rowspan="1" colspan="3"/>
              <cl:property name="value" value="// (1) 트리 before-selection-change 이벤트&#xD;&#xA;function treeBeforeSelectionChangeFunc(e) {&#xD;&#xA;&#x9;/**@type cpr.controls.Tree*/&#xD;&#xA;&#x9;var tre1 = e.control;&#xD;&#xA;&#x9;var item = e.newSelection[0];&#xD;&#xA; &#x9;e.newSelection.forEach(function(each) {&#xD;&#xA; &#x9;&#x9;if (each.children.length>0) {&#xD;&#xA; &#x9;&#x9;&#x9;e.preventDefault();&#xD;&#xA; &#x9;&#x9;&#x9;return;&#xD;&#xA; &#x9;&#x9;}&#x9;&#xD;&#xA;&#x9; });&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// (2) 트리 item-click 이벤트&#xD;&#xA;function treeItemClick(e) {&#xD;&#xA;&#x9;/**@type cpr.controls.Tree*/&#xD;&#xA;&#x9;var tre1 = e.control;&#xD;&#xA;&#x9;// 해당 아이템의 expand 상태를 전환합니다.&#xD;&#xA; &#x9;tre1.toggle(e.item);&#xD;&#xA;}" type="string"/>
              <cl:property name="language" value="javascript" type="enumeration"/>
            </cl:udc>
            <cl:formlayout std:sid="f-layout-1208627f" scrollable="false" hspace="8px" vspace="16px" hseparatorwidth="1" vseparatorwidth="1">
              <cl:rows length="28" unit="PIXEL" autoSizing="true" hidden="false" shadecolor="#000000" minlength="0"/>
              <cl:rows length="1" unit="FRACTION" autoSizing="true" hidden="false" shadetype="NONE" shadecolor="#000000" minlength="0"/>
              <cl:columns length="1" unit="FRACTION"/>
              <cl:columns length="150" unit="PIXEL" shadecolor="transparent"/>
              <cl:columns length="1" unit="FRACTION"/>
            </cl:formlayout>
          </cl:group>
          <cl:output std:sid="output-1c9886a7" class="pb-label" value="적용">
            <cl:formdata std:sid="f-data-e371e75e" row="6" col="0"/>
          </cl:output>
          <cl:group std:sid="group-9877e075" id="grp8">
            <cl:formdata std:sid="f-data-a314e4c3" row="6" col="1"/>
            <cl:tree std:sid="tree-fc722a0f" id="tre1" fieldLabel="위, 아래 방향키로 아이템을 이동합니다. 왼쪽, 오른쪽 방향키로 아이템을 확장합니다. 스페이스, 엔터키를 이용하여 항목을 선택할 수 있습니다.">
              <cl:listener std:sid="listener-69ead05e" name="before-selection-change" handler="onTre1BeforeSelectionChange"/>
              <cl:listener std:sid="listener-58c31a54" name="item-click" handler="onTre1ItemClick"/>
