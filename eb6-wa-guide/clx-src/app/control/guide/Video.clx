      <cl:group std:sid="group-2a2f1861" id="grp4">
        <std:metadata>
          <std:property key="template-uuid" value="f07b9449-b471-4d94-b69e-78b08a168d46"/>
          <std:property key="template-rev" value="1"/>
        </std:metadata>
        <cl:verticaldata std:sid="v-data-b368b9f9" width="1544px" height="683px" autosize="height"/>
        <cl:udc std:sid="ud-control-9c354f52" type="udc.pb.SectionTitle">
          <cl:verticaldata std:sid="v-data-21ccbe78" width="1544px" height="29px"/>
          <cl:property name="title" value="비디오 – 재생관련 기능 제공" type="string"/>
        </cl:udc>
        <cl:group std:sid="group-1e70c5db" id="grp5" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-5937def7" width="1544px" height="642px" autosize="height"/>
          <cl:output std:sid="output-d1e30f09" class="pb-label" value="2. 재생관련기능(재생/일시정지, 3 초이전으로, 3 초이후로, 볼륨조절, 전체화면보기)가 포커스 및 사용 가능 해야 한다.">
            <cl:formdata std:sid="f-data-7db82cd9" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-c287aeae" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-38769d5a" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-9ac50f33" value="-" unselectable="false">
            <cl:formdata std:sid="f-data-8cd3967d" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-6527b3b1" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-e379efed" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-8bca8106" value="-" unselectable="false">
            <cl:formdata std:sid="f-data-696f3f05" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-0c83a9f8" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-27573d5b" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-48f6fdb4" value="항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.&#xD;&#xA;항목 15. (정지 기능 제공) 자동으로 변경되는 콘텐츠는 움직임을 제어할 수 있어야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ec166b86" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-6174dd21" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-a83e4df2" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-732e42df" value="지체 장애, 고령자" unselectable="false">
            <cl:formdata std:sid="f-data-498ed7f9" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-68e7e2ed" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-ff5659a9" row="5" col="0"/>
          </cl:output>
          <cl:output std:sid="output-5d9ac24b" value="비디오의 displayControl=true 로 표시되는 비디오 제어 버튼은 탭 키를 통해 초점을 이동 할 수 없습니다.&#xD;&#xA;따라서 재생/일시정지/시간이동/볼륨조절/전체화면 등에 대한 설정을 위해 포커스가 가능한 버튼 컨트롤을 별도로 배치하여 사용해야 합니다." unselectable="false">
            <cl:formdata std:sid="f-data-068f9ed5" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-600a9412" class="pb-label" value="적용">
            <cl:formdata std:sid="f-data-034f7264" row="6" col="0"/>
          </cl:output>
