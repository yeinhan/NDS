          <cl:verticaldata std:sid="v-data-4508bfac" width="1544px" height="29px"/>
          <cl:property name="title" value="비디오 – 자막 제공" type="string"/>
        </cl:udc>
        <cl:group std:sid="group-bedd990d" id="grp13" class="pb-table wa-table">
          <cl:verticaldata std:sid="v-data-2e6e8d4c" width="1544px" height="605px" autosize="height"/>
          <cl:output std:sid="output-320c8d70" class="pb-label" value="1. 자막을 제공해야 한다.">
            <cl:formdata std:sid="f-data-f4fce933" row="0" col="0" rowspan="1" colspan="4"/>
          </cl:output>
          <cl:output std:sid="output-fe39a97e" class="pb-label" value="컨트롤 속성">
            <cl:formdata std:sid="f-data-a5011ccb" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-6bac81bf" value="-" unselectable="false">
            <cl:formdata std:sid="f-data-705476ed" row="1" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-6834a164" class="pb-label" value="최소버전">
            <cl:formdata std:sid="f-data-4098967f" row="2" col="0"/>
          </cl:output>
          <cl:output std:sid="output-05f938b4" value="-" unselectable="false">
            <cl:formdata std:sid="f-data-10f77d72" row="2" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-667fd02b" class="pb-label" value="관련 웹접근성 지침">
            <cl:formdata std:sid="f-data-5170d53c" row="3" col="0"/>
          </cl:output>
          <cl:output std:sid="output-d30cf35f" value="항목 2. (자막 제공) 멀티미디어 콘텐츠에는 자막, 대본 또는 수어를 제공해야 한다." unselectable="false">
            <cl:formdata std:sid="f-data-ae3a19e0" row="3" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-90bf151d" class="pb-label" value="적용 대상">
            <cl:formdata std:sid="f-data-bf4d6266" row="4" col="0"/>
          </cl:output>
          <cl:output std:sid="output-b50def24" value="청각 장애" unselectable="false">
            <cl:formdata std:sid="f-data-e43a9b8b" row="4" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:output std:sid="output-16382fbb" class="pb-label" value="설명">
            <cl:formdata std:sid="f-data-396a6077" row="5" col="0" rowspan="2" colspan="1"/>
          </cl:output>
          <cl:output std:sid="output-ab56ca87" value="addTextTrack API 를 통해 비디오 컨트롤에 자막을 추가합니다.&#xD;&#xA;추가된 자막은 비디오 컨트롤 내부에 자동으로 추가 할 수 없기 때문에 자막을 표현하기 위한 아웃풋을 함께 배치합니다.&#xD;&#xA;아웃풋의 textTrack 의 cuechange 이벤트를 통해 동적으로 자막을 변경하여 보여줄 수 있어야 하며, 스크린리더가 이를 읽을 수 있도록  ariaLive=&quot;polite&quot; 로 설정합니다." unselectable="false">
            <cl:formdata std:sid="f-data-cc8a39c3" row="5" col="1" rowspan="1" colspan="3"/>
          </cl:output>
          <cl:udc std:sid="ud-control-ad9f56f8" id="udcexamace1" type="udc.exam.udcExamAce">
            <cl:listener std:sid="listener-a3c287f8" name="afterLoad" handler="onUdcexamace1AfterLoad"/>
            <cl:formdata std:sid="f-data-8e4c8b87" row="6" col="1" rowspan="1" colspan="3"/>
          </cl:udc>
          <cl:output std:sid="output-bc3c0650" class="pb-label" value="적용">
            <cl:formdata std:sid="f-data-f8bf149f" row="7" col="0"/>
          </cl:output>
          <cl:group std:sid="group-8dbb6592" id="grp14">
            <cl:formdata std:sid="f-data-9299429a" row="7" col="1"/>
