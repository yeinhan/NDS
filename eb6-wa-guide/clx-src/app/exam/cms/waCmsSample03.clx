      <cl:group std:sid="group-0608aa82" class="form-info">
        <cl:verticaldata std:sid="v-data-8ac57722" width="400px" height="60px" autosize="height"/>
        <cl:output std:sid="output-01a3ab16" class="info-txt" value="- 이용약관 및 개인정보 수집 및 이용 안내를 확인해 주세요.">
