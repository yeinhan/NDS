      <cl:dataset std:sid="d-set-267d742b" id="dsPropView">
        <cl:datacolumnlist>
          <cl:datacolumn comment="필터조건(같은 숫자에 대해서만 필터하여 내용을 보여준다)" std:sid="d-column-5941843b" name="keyNum" datatype="string"/>
          <cl:datacolumn comment="컨트롤명(영문)" std:sid="d-column-4cd817ad" name="control"/>
          <cl:datacolumn comment="속성명" std:sid="d-column-a67ff141" name="propNm"/>
          <cl:datacolumn comment="속성값" std:sid="d-column-309a35a3" name="propVal"/>
          <cl:datacolumn comment="관련 웹접근성 지침" std:sid="d-column-d6e23689" name="relatedWaInst"/>
          <cl:datacolumn std:sid="d-column-4a5e554b" name="code"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">imgBanner1</cl:datavalue>
            <cl:datavalue columnname="control">image</cl:datavalue>
            <cl:datavalue columnname="propNm">alt</cl:datavalue>
            <cl:datavalue columnname="propVal">eXPortal 협업 및 업무향상을 위한 사용자 맞춤 통합 포탈
효율적인 업무 구성을 위한 GateWay 사용자 권한과 역할에 따른 그룹별 맞춤 서비스 제공</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">imgBanner2</cl:datavalue>
            <cl:datavalue columnname="control">image</cl:datavalue>
            <cl:datavalue columnname="propNm">alt</cl:datavalue>
            <cl:datavalue columnname="propVal">eXSignOn 국제 표준 SAML 기반 SSO 단 한번의 로그인으로 다양한 서비스 이용
기업의 각종 시스템이나 인터넷 서비스에 접속 가능한 보안 응용 솔루션</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">imgBanner3</cl:datavalue>
            <cl:datavalue columnname="control">image</cl:datavalue>
            <cl:datavalue columnname="propNm">alt</cl:datavalue>
            <cl:datavalue columnname="propVal">eXERD 쉽고 빠른 이클립스 기반의 지능형 E-R 모델링 툴
사용자 편의성과 개발자 설계역량 향상에 초점을 맞춘 DB모델링 툴</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">imgBanner4</cl:datavalue>
            <cl:datavalue columnname="control">image</cl:datavalue>
            <cl:datavalue columnname="propNm">alt</cl:datavalue>
            <cl:datavalue columnname="propVal">eXCampus
급변하는 대학을 위한
맞춤형 전문 패키지
표준 업무 프로세스 및 데이터 구조 제공
안전성과 확장성을 보장하는 대학 맞춤 패키지</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">imgBanner5</cl:datavalue>
            <cl:datavalue columnname="control">image</cl:datavalue>
            <cl:datavalue columnname="propNm">alt</cl:datavalue>
            <cl:datavalue columnname="propVal">격이 다른 프리미엄 UI
eXBuilder6
코드의 투명성, 이클립스 기반의 통합환경, 파워풀한 팀관리로 업무 효율성 향상</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">imgBanner6</cl:datavalue>
            <cl:datavalue columnname="control">image</cl:datavalue>
            <cl:datavalue columnname="propNm">alt</cl:datavalue>
            <cl:datavalue columnname="propVal">토마토시스템 소프트웨어
합리적인 가격과 편리한 소프트웨어로 풍요로운 세상을 만드는 기업
토마토시스템 소프트웨어로 가치를 엮어나갑니다.</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnPrev</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[tooltip]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[이전 배너]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnNext</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[tooltip]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[다음 배너]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">cbxPlayPause</cl:datavalue>
            <cl:datavalue columnname="control">checkbox</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">exp://checked ? &quot;슬라이드 일시정지&quot; : &quot;슬라이드 자동재생&quot;</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">optBullet</cl:datavalue>
            <cl:datavalue columnname="control">output</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[n번째 배너]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">optH1</cl:datavalue>
            <cl:datavalue columnname="control">output</cl:datavalue>
            <cl:datavalue columnname="propNm">outputType</cl:datavalue>
            <cl:datavalue columnname="propVal">h1</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 18. (제목 제공) 페이지, 프레임, 콘텐츠 블록에는 적절한 제목을 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnShowMore</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">ariaButtonType</cl:datavalue>
            <cl:datavalue columnname="propVal">link</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">grdNotice</cl:datavalue>
            <cl:datavalue columnname="control">grid</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">공지사항</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 3. (표의 구성) 표는 이해하기 쉽게 구성해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnCategory</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">ariaButtonType</cl:datavalue>
            <cl:datavalue columnname="propVal">link</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnCategory</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">분류</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 3. (표의 구성) 표는 이해하기 쉽게 구성해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">optTitle</cl:datavalue>
            <cl:datavalue columnname="control">output</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">제목</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 3. (표의 구성) 표는 이해하기 쉽게 구성해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">optWriDt</cl:datavalue>
            <cl:datavalue columnname="control">output</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">작성일자</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 3. (표의 구성) 표는 이해하기 쉽게 구성해야 한다.</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="대시보드"/>
  </head>
