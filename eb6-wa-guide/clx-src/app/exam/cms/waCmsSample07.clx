        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">cmbSearchFilter</cl:datavalue>
            <cl:datavalue columnname="control">combobox</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">검색필터</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 29. (레이블 제공) 입력 서식에는 대응하는 레이블을 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">ipbSearch</cl:datavalue>
            <cl:datavalue columnname="control">inputbox</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">검색어 입력</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 29. (레이블 제공) 입력 서식에는 대응하는 레이블을 제공해야 한다.</cl:datavalue>
            <cl:datavalue columnname="code"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">ipbSearch</cl:datavalue>
            <cl:datavalue columnname="control">inputbox</cl:datavalue>
            <cl:datavalue columnname="propNm">showClearButton</cl:datavalue>
            <cl:datavalue columnname="propVal">true</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.</cl:datavalue>
            <cl:datavalue columnname="code"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">ipbSearch</cl:datavalue>
            <cl:datavalue columnname="control">inputbox</cl:datavalue>
            <cl:datavalue columnname="propNm">buttonFocusable</cl:datavalue>
            <cl:datavalue columnname="propVal">true</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.</cl:datavalue>
            <cl:datavalue columnname="code"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">ipbSearch</cl:datavalue>
            <cl:datavalue columnname="control">inputbox</cl:datavalue>
            <cl:datavalue columnname="propNm">buttonFocusable</cl:datavalue>
            <cl:datavalue columnname="propVal">true</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnSearch</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">ariaButtonType</cl:datavalue>
            <cl:datavalue columnname="propVal">button</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">cmbRowCnt</cl:datavalue>
            <cl:datavalue columnname="control">combobox</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">페이지당 보여질 게시글 수</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 29. (레이블 제공) 입력 서식에는 대응하는 레이블을 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnRowCnt</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">ariaButtonType</cl:datavalue>
            <cl:datavalue columnname="propVal">button</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnPostTitle</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">fieldLabel</cl:datavalue>
            <cl:datavalue columnname="propVal">제목 introduction to AI</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.</cl:datavalue>
            <cl:datavalue columnname="code"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnPostTitle</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">ariaButtonType</cl:datavalue>
            <cl:datavalue columnname="propVal">link</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">btnWrite</cl:datavalue>
            <cl:datavalue columnname="control">button</cl:datavalue>
            <cl:datavalue columnname="propNm">ariaButtonType</cl:datavalue>
            <cl:datavalue columnname="propVal">button</cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">imgFile</cl:datavalue>
            <cl:datavalue columnname="control">image</cl:datavalue>
            <cl:datavalue columnname="propNm">alt</cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[exp://isFile == "true"? "첨부파일 있음" : "첨부파일 없음"]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst">항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.</cl:datavalue>
            <cl:datavalue columnname="code"/>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
