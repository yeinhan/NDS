    <screen std:sid="screen-ec914514" id="mobile" name="mobile" maxwidth="799px" width="360px" height="760px"/>
    <cl:model std:sid="model-25a10ffd">
      <cl:dataset std:sid="d-set-267d742b" id="dsPropView">
        <cl:datacolumnlist>
          <cl:datacolumn comment="필터조건(같은 숫자에 대해서만 필터하여 내용을 보여준다)" std:sid="d-column-5941843b" name="keyNum" datatype="string"/>
          <cl:datacolumn comment="컨트롤명(영문)" std:sid="d-column-4cd817ad" name="control"/>
          <cl:datacolumn comment="속성명" std:sid="d-column-a67ff141" name="propNm"/>
          <cl:datacolumn comment="속성값" std:sid="d-column-309a35a3" name="propVal"/>
          <cl:datacolumn comment="관련 웹접근성 지침" std:sid="d-column-d6e23689" name="relatedWaInst"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[msg-title]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[아웃풋]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[outputType]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[h5]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 18. (제목 제공) 페이지, 프레임, 콘텐츠 블록에는 적절한 제목을 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[dialog]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[다이얼로그]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[restoreFocus]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[true]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[dialog]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[다이얼로그]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[restoreFocus]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[true]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[dialog]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[다이얼로그]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[autoFocusedTarget]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[true]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 10. (키보드 사용 보장) 모든 기능은 키보드만으로도 사용할 수 있어야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[dialog]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[다이얼로그]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[autoFocusedTarget]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[true]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 11. (초점 이동과 표시) 키보드에 의한 초점은 논리적으로 이동해야 하며, 시각적으로 구별할 수 있어야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[btnCancel]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[button]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[ariaButtonType]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[button]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[btnYes]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[button]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[ariaButtonType]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[button]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="메세지 일반"/>
  </head>
  <body std:sid="body-996e4b65">
    <cl:listener std:sid="listener-2f49bbfc" name="load" handler="onBodyLoad"/>
    <cl:attribute name="wa-prop-key" value="dialog"/>
    <cl:output comment="wa 가이드용" std:sid="output-0e29faa6" value="">
      <cl:attribute name="wa-prop-key" value="dialog"/>
      <cl:formdata std:sid="f-data-78c1df9c" row="0" col="0"/>
    </cl:output>
    <cl:group std:sid="group-928b283d" id="grp1">
      <cl:formdata std:sid="f-data-78be802c" row="1" col="0" rowspan="2" colspan="1"/>
      <cl:group std:sid="group-61555465" id="grp2">
        <cl:formdata std:sid="f-data-41cc3d0d" row="0" col="0"/>
        <cl:output std:sid="output-1bd8cf4f" id="optMsgTitle" class="h5 text-center" value="메세지를 입력하세요" outputtype="h5">
          <cl:attribute name="wa-prop-key" value="msg-title"/>
          <cl:verticaldata std:sid="v-data-62342f9c" width="100%" height="24px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-e504f27b" id="optMsgDetail" class="fs-sm text-gray-600 text-center" tabindex="0" value="메세지 디테일 영역">
          <cl:verticaldata std:sid="v-data-89d5d4a0" width="100%" height="61px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-ab35f739" scrollable="false" spacing="6"/>
      </cl:group>
      <cl:group std:sid="group-5163a58e" id="grp3">
        <cl:formdata std:sid="f-data-e5676a1d" row="1" col="0"/>
        <cl:button std:sid="button-8955cf36" id="btn1" value="취소">
          <cl:listener std:sid="listener-478b4dc6" name="click" handler="onButtonClick"/>
          <cl:attribute name="wa-prop-key" value="btnCancel"/>
          <cl:formdata std:sid="f-data-8a9128ea" row="0" col="0"/>
        </cl:button>
        <cl:button std:sid="button-bd3dd4d3" id="btn2" class="btn-primary" value="확인">
          <cl:listener std:sid="listener-584de90d" name="click" handler="onButtonClick2"/>
          <cl:attribute name="wa-prop-key" value="btnYes"/>
          <cl:formdata std:sid="f-data-a63061b3" row="0" col="1"/>
        </cl:button>
        <cl:formlayout std:sid="f-layout-ddde80a8" scrollable="false" hspace="10px" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:formlayout std:sid="f-layout-07a37c69" scrollable="false" hspace="0px" vspace="10px" top-margin="24px" right-margin="24px" bottom-margin="24px" left-margin="24px">
        <cl:rows length="1" unit="FRACTION"/>
        <cl:rows length="30" unit="PIXEL" autoSizing="true"/>
        <cl:columns length="1" unit="FRACTION"/>
      </cl:formlayout>
    </cl:group>
    <cl:formlayout std:sid="f-layout-a668c32f" scrollable="false" hspace="0px" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="10" unit="PIXEL" shadetype="NONE" shadecolor="transparent"/>
      <cl:rows length="1" unit="FRACTION"/>
      <cl:rows length="30" unit="PIXEL" autoSizing="true"/>
      <cl:columns length="1" unit="FRACTION"/>
    </cl:formlayout>
  </body>
