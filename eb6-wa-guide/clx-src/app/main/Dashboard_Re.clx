    </cl:group>
    <cl:group std:sid="group-738b17c3" id="grp3" class="card">
      <cl:verticaldata std:sid="v-data-e7dd3e3a" width="1440px" height="205px" autosize="height"/>
      <cl:udc std:sid="ud-control-3e103de7" id="udccomformtitle1" type="udc.com.udcComFormTitle">
        <cl:verticaldata std:sid="v-data-b0af077b" width="800px" height="30px" autosize="height"/>
        <cl:property name="title" value="화면 내 적용된 웹 접근성 관련 속성 확인 방법" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-67cacf98" value="" displayexp="sstr(&quot;메인화면의 우측 상단의 햄버거 버튼(≡)&quot;, [&quot;text-secondary&quot;, &quot;text-underline&quot;, &quot;fw-bold&quot;]) +  &quot;을 클릭하면, 현재 화면에 적용된 전체적인 웹 접근성 관련 설정 정보에 대해서 확인 할 수 있습니다.\n&quot;&#xD;&#xA;+ &quot;(우측 그리드를 통해 리스트 확인 가능)\n&quot;&#xD;&#xA;+ &quot;※ 우측 그리드의 행을 더블클릭 시 해당하는 컨트롤 ID가 복사됩니다. &quot;">
        <cl:verticaldata std:sid="v-data-59c40ff8" width="1398px" height="52px" autosize="height"/>
      </cl:output>
      <cl:output std:sid="output-8ff0bb3a" value="" displayexp="&quot;그리드의 각 행을 선택하면, 선택한 컨트롤의 위치를 확인 할 수 있습니다.\n&quot;&#xD;&#xA;+&quot;해당 컨트롤에 대해 보다 더 자세한 정보를 확인하기 위해서는, &quot; &#xD;&#xA;+ sstr(&quot;컨트롤의 우측 상단의 빨간색 영역 (&quot;, [&quot;text-secondary&quot;, 'text-underline', &quot;fw-bold&quot;])&#xD;&#xA;+ sstr(&quot;◥&quot;, [&quot;text-red&quot;])&#xD;&#xA;+ sstr(&quot;) 영역을 클릭&quot;, [&quot;text-secondary&quot;, 'text-underline', &quot;fw-bold&quot;]) + &quot;하면 확인이 가능합니다.&quot;">
        <cl:verticaldata std:sid="v-data-e27a9c05" width="1440px" height="42px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-4e00c0ee" spacing="20" leftmargin="20" rightmargin="20" topmargin="20" bottommargin="20"/>
    </cl:group>
    <cl:group std:sid="group-e053849a" id="grp5" class="card">
      <cl:verticaldata std:sid="v-data-b3ede76a" width="1440px" height="426px" autosize="height"/>
      <cl:udc std:sid="ud-control-b6343ce9" id="udccomformtitle3" type="udc.com.udcComFormTitle">
        <cl:verticaldata std:sid="v-data-ae38c862" width="800px" height="30px" autosize="height"/>
        <cl:property name="title" value="접근성 검토 모드 사용법" type="string"/>
      </cl:udc>
      <cl:output std:sid="output-2762e593" value="" displayexp="sstr(&quot;상단의 접근성 검토모드 체크박스&quot;, [&quot;text-secondary&quot;, &quot;text-underline&quot;, &quot;fw-bold&quot;]) &#xD;&#xA;+ &quot;를 체크/해제하여, 현재 화면에 적용된 접근성 속성 적용 여부를 확인 할 수 있습니다.\n&quot;&#xD;&#xA;+ sstr(&quot;※ 모든 접근성 준수여부를 검사하는 것이 아닌 공통적으로 적용되는 fieldLabel, tooltip, alt 속성에 대한 검사를 진행합니다.\n\n&quot;, [&quot;text-red&quot;, &quot;fw-bold&quot;])&#xD;&#xA;&#xD;&#xA;+ sstr(&quot;접근성 핸들에 마우스를 올려서(hover)&quot;, [&quot;text-secondary&quot;, 'text-underline', &quot;fw-bold&quot;]) &#xD;&#xA;+ &quot; 어떤 속성에 대한 내용인지 확인 할 수 있습니다.\n&quot;&#xD;&#xA;+ &quot; ※ 디스플레이 크기 및 컨트롤 위치로 인해 내용 확인이 어려운 경우, tooltip으로도 내용을 확인할 수 있습니다.&quot;">
        <cl:verticaldata std:sid="v-data-2a5bdc1b" width="1440px" height="104px" autosize="height"/>
      </cl:output>
      <cl:group std:sid="group-7bd49b20" id="grp6" class="cl-form-group">
        <cl:verticaldata std:sid="v-data-bfdfa078" width="400px" height="172px" autosize="both"/>
        <cl:output std:sid="output-6e5f5a32" class="fw-bold" value="접근성 준수(hover)">
          <cl:formdata std:sid="f-data-5331f9e3" row="1" col="0"/>
