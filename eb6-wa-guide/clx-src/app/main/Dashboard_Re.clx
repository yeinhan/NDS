      </cl:udc>
      <cl:output std:sid="output-480fe782" class="pl-2" value="eXBuilder6 로 구현한 화면을 대상으로 웹 접근성을 준수하는 방법에 대한 가이드를 제공합니다.">
        <cl:verticaldata std:sid="v-data-33878bf0" width="100px" height="45px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-961568da" spacing="20"/>
    </cl:group>
    <cl:group std:sid="group-dadec3e9" id="grp1">
      <cl:verticaldata std:sid="v-data-632d9f9c" width="1440px" height="180px" autosize="height"/>
      <cl:group std:sid="group-0817681c" id="grpGuideLine" style="border-radius:20px;" class="card card-guideline">
        <cl:formdata std:sid="f-data-d194d4b8" row="0" col="0"/>
        <cl:output std:sid="output-ee124e25" class="pl-2" value="웹 접근성 지침 33개 항목과 각 지침 내용에 해당되는 컨트롤 목록을 확인할 수 있습니다.">
          <cl:formdata std:sid="f-data-bbbac422" row="1" col="1"/>
        </cl:output>
        <cl:button std:sid="button-4b64b0d8" id="btn1" value="바로가기">
          <cl:listener std:sid="listener-3f03f484" name="click" handler="onBtn1Click"/>
          <cl:formdata std:sid="f-data-b0f2781f" halign="LEFT" width="120" row="2" col="1"/>
        </cl:button>
        <cl:img std:sid="image-af4d7979" id="img7" src="../../theme/images/dashboard/imgGuideLine01.png" alt="접근성 지침 목록">
