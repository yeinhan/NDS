          <cl:datacolumn comment="속성값" std:sid="d-column-309a35a3" name="propVal"/>
          <cl:datacolumn comment="관련 웹접근성 지침" std:sid="d-column-d6e23689" name="relatedWaInst"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="keyNum">1</cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[image]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[alt]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[eXCFrame 로고]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 1. (적절한 대체 텍스트 제공) 텍스트 아닌 콘텐츠는 그 의미나 용도를 인식할 수 있도록 대체 텍스트를 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[2]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[output]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[outputType]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[h1]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 18. (제목 제공) 페이지, 프레임, 콘텐츠 블록에는 적절한 제목을 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[3]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[inputbox]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[fieldLabel]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[아이디]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 29. (레이블 제공) 입력 서식에는 대응하는 레이블을 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[4]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[inputbox]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[fieldLabel]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[비밀번호]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 29. (레이블 제공) 입력 서식에는 대응하는 레이블을 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec dev-comment="eXBuilder6 이미지 : alt=&quot;eXBuilder6 로고&quot;&#xD;&#xA;로그인 아웃풋 : outputType=&quot;h1&quot;&#xD;&#xA;아이디 인풋 : fieldLabel=&quot;아이디&quot;&#xD;&#xA;비밀번호 인풋 : fieldLabel=&quot;비밀번호&quot;" title="로그인"/>
