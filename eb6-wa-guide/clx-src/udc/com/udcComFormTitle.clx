<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-6872a2ba" version="1.0.4034">
  <head std:sid="head-7a68023b">
    <screen std:sid="screen-7f9d6102" id="default" name="default" minwidth="1280px" width="1280px" height="760px" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-e52af678" id="tablet" name="tablet" minwidth="800px" maxwidth="1279px" width="800px" height="760px"/>
    <screen std:sid="screen-2f55b886" id="mobile" name="mobile" maxwidth="799px" width="360px" height="760px"/>
    <cl:model std:sid="model-5b2b82fd">
      <cl:dataset std:sid="d-set-267d742b" id="dsPropView">
        <cl:datacolumnlist>
          <cl:datacolumn comment="필터조건(같은 숫자에 대해서만 필터하여 내용을 보여준다)" std:sid="d-column-5941843b" name="keyNum" datatype="string"/>
          <cl:datacolumn comment="컨트롤명(영문)" std:sid="d-column-4cd817ad" name="control"/>
          <cl:datacolumn comment="속성명" std:sid="d-column-a67ff141" name="propNm"/>
          <cl:datacolumn comment="속성값" std:sid="d-column-309a35a3" name="propVal"/>
          <cl:datacolumn comment="관련 웹접근성 지침" std:sid="d-column-d6e23689" name="relatedWaInst"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[formTitle]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[output]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[outputType]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[h4]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 18. (제목 제공) 페이지, 프레임, 콘텐츠 블록에는 적절한 제목을 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec>
      <cl:property name="title" type="string" bindable="true" std:desc="제목(ctrl이 지정된 경우, ctrl 컨트롤의 fieldLabel로 대체됨)"/>
      <cl:property name="ctrl" type="control"/>
    </cl:appspec>
  </head>
  <body std:sid="body-a4e31432" style="top:0px; left:0px; width:800px; height:24px;">
    <cl:listener std:sid="listener-4f8d10a4" name="load" handler="onBodyLoad"/>
    <cl:output std:sid="output-5c61f5a7" id="optTitle" class="h5" value="타이틀을 입력하세요" outputtype="h4">
      <cl:attribute name="wa-prop-key" value="formTitle"/>
      <cl:apppropbind property="value" app-property="title"/>
      <cl:formdata std:sid="f-data-66a1acd4" row="0" col="0"/>
    </cl:output>
    <cl:formlayout std:sid="f-layout-19d86453" scrollable="false" hspace="0px" vspace="0px" top-margin="1fr" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="24" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" minlength="24" syncminlength="false"/>
      <cl:columns length="300" unit="PIXEL" autoSizing="true" syncminlength="false"/>
      <cl:columns length="1" unit="FRACTION"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>