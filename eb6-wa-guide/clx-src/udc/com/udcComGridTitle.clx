<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-55323813" version="1.0.0.0">
  <head std:sid="head-d7c81b75">
    <title>Title2</title>
    <screen std:sid="screen-be277567" id="eXFrame" name="eXFrame" minwidth="1320px" width="1320px" height="780px" customHeight="600" customWidth="800" active="false"/>
    <screen std:sid="screen-735db646" id="default" name="default" minwidth="1024px" maxwidth="1319px" width="1024px" height="768px" active="true"/>
    <screen std:sid="screen-4c5e63f4" id="tablet" name="tablet" minwidth="500px" maxwidth="1023px" width="500px" height="667px"/>
    <screen std:sid="screen-5582eff1" id="mobile" name="mobile" maxwidth="499px" width="350px" height="525px"/>
    <cl:model std:sid="model-6d7cc3ff">
      <cl:dataset std:sid="d-set-267d742b" id="dsPropView">
        <cl:datacolumnlist>
          <cl:datacolumn comment="필터조건(같은 숫자에 대해서만 필터하여 내용을 보여준다)" std:sid="d-column-5941843b" name="keyNum" datatype="string"/>
          <cl:datacolumn comment="컨트롤명(영문)" std:sid="d-column-4cd817ad" name="control"/>
          <cl:datacolumn comment="속성명" std:sid="d-column-a67ff141" name="propNm"/>
          <cl:datacolumn comment="속성값" std:sid="d-column-309a35a3" name="propVal"/>
          <cl:datacolumn comment="관련 웹접근성 지침" std:sid="d-column-d6e23689" name="relatedWaInst"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[gridTitle]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[output]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[outputType]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[h4]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 18. (제목 제공) 페이지, 프레임, 콘텐츠 블록에는 적절한 제목을 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[btnTools]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[button]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[tooltip]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[필터/찾기 등]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 29. (레이블 제공) 입력 서식에는 대응하는 레이블을 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="keyNum"><![CDATA[btnTools]]></cl:datavalue>
            <cl:datavalue columnname="control"><![CDATA[button]]></cl:datavalue>
            <cl:datavalue columnname="propNm"><![CDATA[ariaButtonType]]></cl:datavalue>
            <cl:datavalue columnname="propVal"><![CDATA[button]]></cl:datavalue>
            <cl:datavalue columnname="relatedWaInst"><![CDATA[항목 19. (적절한 링크 텍스트) 링크 텍스트는 용도나 목적을 이해할 수 있도록 제공해야 한다.]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec dev-description="그리드 타이틀(Title)">
      <cl:property name="ctrl" type="control" bindable="false" std:desc="그리드 컨트롤 객체"/>
      <cl:property name="rowCount" type="string" default="0" bindable="true" std:desc=""/>
      <cl:property name="title" type="string" default="제목없음" bindable="true"/>
      <cl:property name="showExportExcel" type="boolean" default="true" bindable="true" std:desc="엑셀 파일 Export 버튼을 보여줄지 여부"/>
      <cl:property name="exportExcelTitle" type="string" bindable="true" std:desc="출력 엑셀파일명(디폴트는 그리드 명칭임)"/>
      <cl:property name="exportHiddenColumns" type="boolean" default="false" bindable="true" std:desc="숨긴 컬럼도 엑셀 출력에 포함할 경우에 true로 지정(디폴트: false임)"/>
      <cl:property name="exportExcludePart" type="string" bindable="true" std:desc="엑셀 파일 Export시 출력제외 영역(footer, gfooter 등)"/>
      <cl:property name="showExpandBtn" type="boolean" default="true" std:desc="확대 버튼을 보여줄지 여부"/>
    </cl:appspec>
  </head>
  <body std:sid="body-87eeef7c" style="top:0px; left:0px; width:800px; height:24px;" class="grp-title">
    <cl:listener std:sid="listener-7c142040" name="load" handler="onBodyLoad"/>
    <cl:listener std:sid="listener-a24244a9" name="property-change" handler="onBodyPropertyChange"/>
    <cl:output std:sid="output-582fb466" id="optTitle" class="h5" outputtype="h4">
      <cl:attribute name="wa-prop-key" value="gridTitle"/>
      <cl:attribute name="wa-prop-dataset" value="dsPropView"/>
      <cl:apppropbind property="value" category="PROPERTY" app-property="title"/>
      <cl:formdata std:sid="f-data-9956b2b1" row="0" col="0"/>
    </cl:output>
    <cl:output std:sid="output-ace14b8a" id="optRowCount" class="text-center fs-sm" displayexp="&quot;총건수 &quot; + sstr(text, [&quot;text-primary&quot;]) +&quot;건&quot;">
      <cl:apppropbind property="value" category="PROPERTY" app-property="rowCount"/>
      <cl:formdata std:sid="f-data-ab56539f" row="0" col="1"/>
    </cl:output>
    <cl:button std:sid="button-923e8267" id="btnExcelExport" class="btn-p-0" tooltip="엑셀 내려받기" value="">
      <cl:listener std:sid="listener-5166e6be" name="click" handler="onBtnExcelExportClick"/>
      <cl:apppropbind property="visible" category="PROPERTY" app-property="showExportExcel"/>
      <cl:formdata std:sid="f-data-45cb5247" row="0" col="3"/>
    </cl:button>
    <cl:group std:sid="group-f1168d7c">
      <cl:formdata std:sid="f-data-5f0d1618" height="20" row="0" col="2" rowspan="1" colspan="1"/>
      <cl:button std:sid="button-e6ea7d4c" id="btnTools" class="btn-transparent" tooltip="필터/찾기 등" icon="../../theme/images/controls/grid/ic_btn_setting.png">
        <cl:listener std:sid="listener-f6d6ee43" name="click" handler="onBtnToolsClick"/>
        <cl:attribute name="wa-prop-key" value="btnTools"/>
        <cl:flowlayoutdata std:sid="f-data-c692d163" width="20px" height="20px"/>
      </cl:button>
      <cl:flowlayout std:sid="f-layout-3c749f36" scrollable="false" hspacing="6" vspacing="6" leftmargin="0" rightmargin="0" topmargin="2" bottommargin="0"/>
    </cl:group>
    <cl:formlayout std:sid="f-layout-c3310054" scrollable="false" hspace="10px" vspace="0px" top-margin="1fr" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="24" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
      <cl:columns length="200" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
      <cl:columns length="60" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
      <cl:columns length="1" unit="FRACTION"/>
      <cl:columns length="24" unit="PIXEL" hidden="true"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler>
      <std:guide position="266"/>
      <std:guide position="329"/>
    </std:hruler>
    <std:vruler/>
  </std:studiosetting>
</html>