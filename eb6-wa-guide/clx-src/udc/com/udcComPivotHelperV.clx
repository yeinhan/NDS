            <cl:datavalue columnname="value">desc</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="피벗 그리드(세로)">
      <cl:property name="dataset" type="control" std:desc="피벗 타겟 데이터 셋"/>
      <cl:property name="maxWidth" type="number" default="250" std:desc="피벗 도우미의 최대 사이즈"/>
      <cl:event name="execute" type="cpr.events.CMouseEvent" std:desc="피벗을 실행했을 때 발생하는 이벤트"/>
      <cl:event name="reset" type="cpr.events.CMouseEvent" std:desc="피벗을 초기화할 때 발생하는 이벤트"/>
      <cl:event name="update" type="cpr.events.CValueChangeEvent" std:desc="피벗의 자동 업데이트 상태가 변경되었을 때 발생하는 이벤트"/>
      <cl:event name="toggle" type="cpr.events.CMouseEvent" std:desc="피벗 컨텐츠가 숨겨지거나 표시되었을 때 발생하는 이벤트"/>
    </cl:appspec>
  </head>
