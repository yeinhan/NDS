            <cl:datavalue columnname="label">최솟값</cl:datavalue>
            <cl:datavalue columnname="value">min</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="label">최댓값</cl:datavalue>
            <cl:datavalue columnname="value">max</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
      <cl:dataset std:sid="d-set-456598c1" id="dsCRFld">
